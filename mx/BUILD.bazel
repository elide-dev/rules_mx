load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files([
    "export.py",
    "launcher.py.tpl",
    "module_descriptor.patch",
    "register.patch",
    "symbolic_classpath.patch",
    "upstream.BUILD",
])

py_test(
    name = "export_test",
    size = "small",
    # This integration test launches a fresh mx process for each CLI invocation.
    timeout = "moderate",
    srcs = ["export_test.py"],
    args = [
        "$(rootpath @graal_mx//:mx_cli)",
        "$(rootpath :projects.bzl)",
        "$(rootpath //tests/processing:.mx_vcs_root)",
    ],
    data = [
        ":projects.bzl",
        "//tests/processing:.mx_vcs_root",
        "//tests/processing:fixture",
        "@graal_mx//:mx_cli",
    ],
)

config_setting(
    name = "unified_jvm",
    flag_values = {"@rules_elide//elide:unified_jvm_compile": "true"},
    visibility = ["//visibility:public"],
)

py_binary(
    name = "patch_module",
    srcs = ["patch_module.py"],
)

py_binary(
    name = "pack_layout",
    srcs = ["pack_layout.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "pack_jar",
    srcs = ["pack_jar.py"],
)

py_test(
    name = "pack_jar_test",
    size = "small",
    srcs = ["pack_jar_test.py"],
    args = ["$(rootpath :pack_jar)"],
    data = [":pack_jar"],
)

py_binary(
    name = "shade",
    srcs = [
        "pack_jar.py",
        "shade.py",
    ],
    imports = ["."],
    main = "shade.py",
)

py_binary(
    name = "pack_native_resource",
    srcs = [
        "pack_jar.py",
        "pack_native_resource.py",
    ],
    imports = ["."],
    main = "pack_native_resource.py",
    visibility = ["//graal:__pkg__"],
)

py_binary(
    name = "sulong_cmake",
    srcs = ["sulong_cmake.py"],
    visibility = ["//visibility:public"],
)
