module(
    name = "rules_mx",
    version = "0.1.0",  # x-release-please-version
    bazel_compatibility = [">=9.3.3"],
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "rules_elide", version = "0.6.1")
# rules_elide has no release with the unified JVM builder, Native Image toolchain and
# JavaBuilder processor fixes yet, so pin its main branch by commit.
archive_override(
    module_name = "rules_elide",
    integrity = "sha256-//E8/7JDZWKKiQg4edEJN8ye3S8VaD5EhsQe60GYhnM=",
    strip_prefix = "rules_elide-50e0e8f8b3696a86b4294491740434db4e9d4260",
    urls = ["https://github.com/elide-dev/rules_elide/archive/50e0e8f8b3696a86b4294491740434db4e9d4260.tar.gz"],
)

bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "contrib_rules_jvm", version = "0.35.0")

elide = use_extension("@rules_elide//elide:extensions.bzl", "elide", dev_dependency = True)
elide.install(
    python = True,
    version = "1.6.2",
)
use_repo(elide, "elide_linux_amd64", "elide_linux_arm64", "elide_macos_arm64", "elide_toolchains")

register_toolchains(
    "@elide_toolchains//:all",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(python_version = "3.13")

mx_sources = use_extension("//mx:extensions.bzl", "mx_sources")
use_repo(mx_sources, "graal_mx")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.60.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.25.6")

llvm = use_extension("//tools/cc:extensions.bzl", "llvm")
use_repo(llvm, "elide_toolchain_darwin_arm64", "elide_toolchain_linux_amd64", "elide_toolchain_linux_arm64")

register_toolchains(
    "//tools/cc:all",
    dev_dependency = True,
)

labsjdk = use_extension("//mx:labsjdk.bzl", "labsjdk", dev_dependency = True)
use_repo(
    labsjdk,
    "labsjdk_darwin_aarch64",
    "labsjdk_darwin_aarch64_toolchain_config_repo",
    "labsjdk_linux_aarch64",
    "labsjdk_linux_aarch64_toolchain_config_repo",
    "labsjdk_linux_amd64",
    "labsjdk_linux_amd64_toolchain_config_repo",
)

register_toolchains(
    "@labsjdk_darwin_aarch64_toolchain_config_repo//:all",
    "@labsjdk_linux_aarch64_toolchain_config_repo//:all",
    "@labsjdk_linux_amd64_toolchain_config_repo//:all",
    dev_dependency = True,
)

bazel_dep(name = "rules_graalvm", version = "0.12.0", dev_dependency = True)
archive_override(
    module_name = "rules_graalvm",
    integrity = "sha256-KN+4Pwe4X81JnQNLnxDXYfhUwGHAgrULmu2Pt8pTISE=",
    strip_prefix = "rules_graalvm-bc5d221128382487bb7c2df1fed996114b40ea2e",
    urls = ["https://github.com/sgammon/rules_graalvm/archive/bc5d221128382487bb7c2df1fed996114b40ea2e.tar.gz"],
)

inject_repo(elide, "rules_graalvm")

register_toolchains(
    "@elide_toolchains//graalvm:all",
    dev_dependency = True,
)

bazel_dep(name = "rules_cc", version = "0.2.18")

# Reuse Gazelle's locked JUnit and ANTLR runtime artifacts.
bazel_dep(name = "rules_jvm_external", version = "6.10", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
use_repo(maven, "contrib_rules_jvm_deps")

# Real Graal sources for the incremental migration. The root module can select
# another archive with graal.source(); see graal/README.md.
graal = use_extension("//graal:extensions.bzl", "graal", dev_dependency = True)
use_repo(graal, "graal")

sdk_llvm = use_extension("//graal:sdk_llvm.bzl", "sdk_llvm_inputs", dev_dependency = True)
use_repo(
    sdk_llvm,
    "graal_llvm_compiler_rt",
    "graal_llvm_darwin_aarch64",
    "graal_llvm_linux_aarch64",
    "graal_llvm_linux_amd64",
    "graal_llvm_linux_riscv64",
    "graal_llvm_windows_amd64",
    "graal_musl_aarch64",
    "graal_musl_amd64",
)

visualvm = use_extension("//graal:visualvm.bzl", "visualvm_inputs", dev_dependency = True)
use_repo(
    visualvm,
    "visualvm_common",
    "visualvm_linux_amd64",
    "visualvm_linux_arm64",
    "visualvm_macos",
    "visualvm_windows_amd64",
)

shaded_inputs = use_repo_rule("//graal:shaded_inputs.bzl", "shaded_inputs")

shaded_inputs(
    name = "graal_shaded_inputs",
    dev_dependency = True,
    lock = "//graal:shaded_inputs.json",
)

hsdis = use_repo_rule("//graal:hsdis.bzl", "hsdis")

hsdis(
    name = "hsdis_darwin_aarch64",
    dev_dependency = True,
    lock = "//graal:hsdis.json",
    platform = "darwin_aarch64",
)

hsdis(
    name = "hsdis_linux_amd64",
    dev_dependency = True,
    lock = "//graal:hsdis.json",
    platform = "linux_amd64",
)

hsdis(
    name = "hsdis_linux_aarch64",
    dev_dependency = True,
    lock = "//graal:hsdis.json",
    platform = "linux_aarch64",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "rules_license", version = "1.0.0", dev_dependency = True)

libffi = use_repo_rule("//graal:libffi.bzl", "graal_libffi")

libffi(
    name = "graal_libffi",
    dev_dependency = True,
    lock = "//graal:libffi.json",
)
