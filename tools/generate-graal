def svm_url_inputs(directory):
    """Pins for SVM_URL_LIBRARIES, keyed by repository name suffix."""
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    libraries = suite["libraries"]
    pins = {}

    def pin(key, library, config):
        algo, digest = config["digest"].split(":")
        (url,) = config["urls"]
        url = url.format(**{**library, **config})
        pins[key] = dict(
            urls=[url],
            integrity=algo + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
            file=url.rsplit("/", 1)[1],
        )
        if url.endswith((".tar.gz", ".tgz")):
            pins[key]["archive"] = True

    for name in SVM_URL_LIBRARIES:
        if not (library := libraries.get(name)):
            continue
        if "os_arch" not in library:
            pin(name.lower(), library, library)
            continue
        for platform, (os_name, arch, _) in SVM_INPUT_PLATFORMS.items():
            config = library["os_arch"].get(os_name, {}).get(arch)
            if config and not config.get("optional"):
                pin(f"{name.lower()}_{platform}", library, config)
    return pins


def svm_url_library_rules(directory):
    """java_import targets for the URL-pinned and checked-in SubstrateVM JAR libraries."""
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    pins = svm_url_inputs(directory)
    rules = []
    flags = []
    for name in SVM_URL_LIBRARIES:
        library = suite["libraries"].get(name)
        if not library or name == "LLVM_LLD_STANDALONE":
            continue
        deps = [":" + dep for dep in library.get("dependencies", [])]
        if "os_arch" in library:
            jars = {
                f":{setting}": [f"@graal_svm_{name.lower()}_{platform}//file"]
                for platform, (_, _, setting) in SVM_INPUT_PLATFORMS.items()
                if f"{name.lower()}_{platform}" in pins
            }
            jars_expr = f"select({json.dumps(jars)})"
            compatible = (
                "select("
                + json.dumps(
                    {setting: [] for setting in jars}
                    | {"//conditions:default": ["@platforms//:incompatible"]}
                )
                + ")"
            )
        else:
            jars_expr = json.dumps([f"@graal_svm_{name.lower()}//file"])
            compatible = "[]"
        rules.append(
            # mx puts library dependencies on the classpath of every user, as exports do.
            f'java_import(name = "{name}", jars = {jars_expr}, exports = {json.dumps(deps)}, '
            f'target_compatible_with = {compatible}, visibility = ["//visibility:public"])\n'
        )
        flags.extend(["--java-dep", f"substratevm:{name}=:{name}"])
        if "os_arch" in library:
            # svm_platform_requires adds the module names for each platform.
            flags.extend(["--platform-library", f"substratevm:{name}"])
    # Libraries checked into the suite, such as a JAR whose resource path contains a space.
    for name, library in sorted(suite["libraries"].items()):
        if "path" in library and library["path"].endswith(".jar"):
            rules.append(
                f'java_import(name = "{name}", jars = [{json.dumps(library["path"])}], testonly = True, '
                'visibility = ["//visibility:public"])\n'
            )
            flags.extend(["--java-dep", f"substratevm:{name}=:{name}"])
    if rules:
        rules.insert(0, 'load("@rules_java//java:java_import.bzl", "java_import")\n')
    return "".join(rules), flags


# CI runs independent upstream tests from each newly imported project. All other
# discovered classes retain individually addressable labels for explicit runs.
HARNESS_TESTS = {
    "jdk.graal.compiler.test": "IntegerDivRemConstantTest IntegerDivPowerOf2Test IntegerSwitchTest IntegerBoxEqualsTest TestAnnotationsOnTypes TestAnnotationsOnMethods TestAnnotationsOnFields TestAnnotationsOnRecordComponents SLCompileASTTestSuite SLCompileBytecodeTestSuite SLCompileImmediatelyASTTestSuite SLCompileImmediatelyBytecodeTestSuite DumpPathTest HotSpotGraalOptionValuesTest CRC32SubstitutionsTest CRC32CSubstitutionsTest BytecodeDisassemblerTest AddModulesTest VectorAPISmokeTest",
}


def qualified_tests(directory):
    suite = directory.name
    metadata = runpy.run_path(str(directory / f"mx.{suite}/suite.py"))["suite"]
    full = (
        set(metadata["distributions"]["TRUFFLE_TEST"]["dependencies"])
        if suite == "truffle"
        else set()
    )
    projects = json.loads((directory / "mx-graph.json").read_text())["projects"]
    labels = []
    for project in projects:
        names = (
            "*" if project["name"] in full else HARNESS_TESTS.get(project["name"], "")
        )
        if names == "*":
            labels.extend(":" + project["name"] + "." + cls for cls in project["tests"])
            continue
        for short in names.split():
            matches = [c for c in project["tests"] if c.rsplit(".", 1)[-1] == short]
            if len(matches) != 1:
                raise ValueError(
                    f"Expected one {short} in {project['name']}, got {matches}"
                )
            labels.append(":" + project["name"] + "." + matches[0])
    return f'test_suite(name = "harness_tests", tests = {json.dumps(sorted(labels))}, visibility = ["//visibility:public"])\n'


