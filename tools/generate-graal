def sdk_descriptor_rules(directory):
    suite = runpy.run_path(str(directory / "mx.sdk/suite.py"))["suite"]
    template_root = directory.parent
    gcc = re.sub(
        r"<[a-z]+:([^>]+)>", r"\1", (template_root / "gcc.ninja_template").read_text()
    )
    msvc = re.sub(
        r"<[a-z]+:([^>]+)>", r"\1", (template_root / "msvc.ninja_template").read_text()
    )
    descriptors = {}
    llvm_platforms = sdk_llvm_inputs(directory).keys() - {"compiler_rt"}
    for name in (
        "LLVM_NINJA_TOOLCHAIN",
        "MUSL_NINJA_TOOLCHAIN",
        "MUSL_CMAKE_TOOLCHAIN",
    ):
        dist = suite["distributions"][name]
        kind = dist["native_toolchain"]["kind"]
        configurations = {}
        if name == "LLVM_NINJA_TOOLCHAIN":
            for platform in sorted(llvm_platforms):
                os_name, _, _ = platform.partition("_")
                configurations[platform] = dist["os"][os_name]
        else:
            for cpu, config in dist["os_arch"]["linux"].items():
                if not cpu.startswith("<"):
                    configurations["linux_" + cpu] = config
        platforms = {}
        for platform, config in configurations.items():
            content = config["layout"]["toolchain." + kind]["value"]
            if kind == "cmake":
                content = content.replace(
                    "<path:MUSL_GCC_TOOLCHAIN>", "${CMAKE_CURRENT_LIST_DIR}/toolchain"
                )
            else:
                content = content.replace(
                    "include <ninja-toolchain:GCC_NINJA_TOOLCHAIN>", gcc
                )
                content = content.replace(
                    "include <ninja-toolchain:MSVC_NINJA_TOOLCHAIN>", msvc
                )
                content = content.replace("<path:MUSL_GCC_TOOLCHAIN>", "toolchain")
                content = content.replace("<path:LLVM_TOOLCHAIN>", "toolchain")
            if re.search(r"<[a-z-]+:[^>]+>", content):
                raise ValueError(f"Unresolved substitution in {name} for {platform}")
            platforms[platform] = content
        descriptors[name] = dict(kind=kind, platforms=platforms)
    return (
        'load("@rules_mx//graal:sdk_llvm.bzl", "sdk_toolchain_descriptors")\n'
        f"sdk_toolchain_descriptors(descriptors = {json.dumps(descriptors)})\n"
    )


