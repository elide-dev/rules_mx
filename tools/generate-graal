def qualified_tests(directory):
    projects = json.loads((directory / "mx-graph.json").read_text())["projects"]
    labels = []
    for project in projects:
        names = HARNESS_TESTS.get(project["name"], "")
        if names == "*":
            labels.extend(":" + project["name"] + "." + cls for cls in project["tests"])
            continue
        for short in names.split():
            matches = [c for c in project["tests"] if c.rsplit(".", 1)[-1] == short]
            if len(matches) != 1:
                raise ValueError(
                    f"Expected one {short} in {project['name']}, got {matches}"
                )
            labels.append(":" + project["name"] + "." + matches[0])
    return f'test_suite(name = "harness_tests", tests = {json.dumps(sorted(labels))}, visibility = ["//visibility:public"])\n'


def compiler_harness(directory):
    metadata = runpy.run_path(str(directory / "mx.compiler/suite.py"))["suite"]
    project = metadata["projects"]["jdk.graal.compiler.test"]
    graph = json.loads((directory / "mx-graph.json").read_text())
    tests = next(
        p["tests"] for p in graph["projects"] if p["name"] == "jdk.graal.compiler.test"
    )
    flags = [
        "-XX:-UseJVMCICompiler",
        "-XX:TypeProfileWidth=8",
        "-Djdk.graal.TrackNodeSourcePosition=true",
        "-Dpolyglot.engine.DynamicCompilationThresholds=false",
        "-Dpolyglot.ConstantOptionKeyPartialEvaluationLanguage.ConstantOption1=true",
        "--enable-native-access=ALL-UNNAMED",
    ]
    flags += [
        f"--add-opens={mod}/{pkg}=ALL-UNNAMED"
        for mod, pkgs in project["requiresConcealed"].items()
        if mod != "jdk.internal.vm.ci"
        for pkg in pkgs
    ]
    rules = [
        'load("@rules_mx//mx:graph.bzl", "mx_test_class")',
        'load("@rules_mx//graal:simplelanguage.bzl", "compiler_test_runner")',
        f'compiler_test_runner(name = "compiler_junit", jvm_flags = {json.dumps(flags)})',
    ]
    for name, target in (("HSDIS_LIBRARY", "jar"), ("hsdis_library_file", "library")):
        choices = {
            f"@rules_mx//tools:exec_{config}": f"@hsdis_{platform}//:{target}"
            for config, platform in (
                ("linux_amd64", "linux_amd64"),
                ("linux_arm64", "linux_aarch64"),
                ("macos_arm64", "darwin_aarch64"),
            )
        }
        rules.append(
            f'alias(name = "{name}", actual = select({json.dumps(choices)}), visibility = ["//visibility:public"])'
        )
    # Preserve the individually qualified regression labels from the earlier SL migration.
    for name in (
        "GR35581Test",
        "GR36613Test",
        "GR42688Test",
        "TruffleDirectCallNodeTest",
    ):
        cls = "jdk.graal.compiler.truffle.test." + name
        if cls not in tests:
            raise ValueError(f"Missing compiler regression {cls}")
        rules.append(
            f'mx_test_class(name = "{name}", launcher = ":compiler_junit", test_class = "{cls}") # keep'
        )
    return "\n".join(rules) + "\n"


def sdk_native_projects(sdk):
    suite = runpy.run_path(str(sdk / "mx.sdk/suite.py"))["suite"]
    name = "org.graalvm.nativebridge.launcher"
    resource = "NATIVEBRIDGE_LAUNCHER_RESOURCES"
    project = suite["projects"][name]
    layout = suite["distributions"][resource]
    if (
        layout["layout"] != {"<os>/<arch>/": "dependency:" + name}
        or not project["use_jdk_headers"]
        or project["native"] != "executable"
    ):
        raise ValueError("Native Bridge launcher layout or project type changed")
    src = sdk / project["subDir"] / name / "src"
    platforms = {os: arch["<others>"] for os, arch in project["os_arch"].items()}
    attrs = dict(
        name=name,
        deliverable=project["deliverable"],
        srcs=sorted(p.relative_to(sdk).as_posix() for p in src.rglob("*.cc")),
        cflags={os: cfg["cflags"] for os, cfg in platforms.items()},
        ldlibs={os: cfg.get("ldlibs", []) for os, cfg in platforms.items()},
        resource=resource,
        platforms=layout["platforms"],
    )
    probe = "org.graalvm.toolchain.test"
    probe_project = suite["projects"][probe]
    if probe_project["class"] != "ToolchainTestProject" or probe_project[
        "buildDependencies"
    ] != ["LLVM_TOOLCHAIN"]:
        raise ValueError("SDK toolchain test contract changed")
    probe_sources = [
        f"{probe_project['subDir']}/{probe}/{src}" for src in ("hello.c", "hello.cc")
    ]
    return (
        'load("@rules_mx//graal:nativebridge.bzl", "nativebridge_launcher")\n'
        'load("@rules_mx//graal:toolchain_test.bzl", "sdk_toolchain_test")\n\n'
        + f'sdk_toolchain_test(name = "{probe}", sources = {json.dumps(probe_sources)})\n\n'
        + "nativebridge_launcher(\n"
        + "".join(f"    {key} = {json.dumps(value)},\n" for key, value in attrs.items())
        + ")\n\n"
    )


def truffle_native_projects(directory):
    suite = runpy.run_path(str(directory / "mx.truffle/suite.py"))["suite"]
    name = "com.oracle.truffle.attach"
    resource = "TRUFFLE_ATTACH_RESOURCES"
    project = suite["projects"][name]
    dist = suite["distributions"][resource]
    [(destination, source)] = dist["layout"].items()
    if (
        source != "dependency:" + name
        or project["native"] != "shared_lib"
        or not project["use_jdk_headers"]
        or project["buildDependencies"]
    ):
        raise ValueError("Unsupported Truffle attach project or resource layout")
    src = directory / project["subDir"] / name / "src"
    attrs = dict(
        name=name,
        resource=resource,
        deliverable=project["deliverable"],
        srcs=sorted(p.relative_to(directory).as_posix() for p in src.rglob("*.c")),
        cflags={os: a["<others>"]["cflags"] for os, a in project["os_arch"].items()},
        ldlibs={
            os: a["<others>"].get("ldlibs", []) for os, a in project["os_arch"].items()
        },
        platforms=dist["platforms"],
        destination=destination,
        file_list=dist["fileListEntry"],
        hash_entry=dist["hashEntry"],
    )
    fixture_rules = []
    fixture_root = directory / "src/com.oracle.truffle.sl.test/src/tests"
    for parent in sorted({p.parent for p in fixture_root.rglob("*.sl")}):
        (parent / "BUILD.bazel").write_text(
            'exports_files(glob(["*.sl", "*.output", "*.input"], allow_empty = True), visibility = ["//truffle:__pkg__"])\n'
        )
        names = sorted(p.stem for p in parent.glob("*.sl"))
        inputs = sorted(p.stem for p in parent.glob("*.input"))
        prefix = ".".join(parent.relative_to(fixture_root).parts)
        package = "//" + parent.relative_to(directory.parent).as_posix()
        fixture_rules.append(
            f"sl_fixture_tests(package = {json.dumps(package)}, names = {json.dumps(names)}, "
            f"inputs = {json.dumps(inputs)}, prefix = {json.dumps(prefix + '.' if prefix else '')})\n"
        )
    projects = json.loads((directory / "mx-graph.json").read_text())["projects"]
    tck = next(p for p in projects if p["name"] == "com.oracle.truffle.tck.tests")
    return (
        'load("@rules_mx//graal:attach.bzl", "truffle_attach")\n\n'
        + 'load("@rules_mx//graal:simplelanguage.bzl", "optimizing_junit", "simplelanguage", "sl_fixture_tests")\n\n'
        + 'simplelanguage(name = "sl")\n\n'
        + "".join(fixture_rules)
        + "".join(
            f'optimizing_junit(name = "sl_jit.tck.{cls.rsplit(".", 1)[1]}", test_class = "{cls}", '
            f'runtime_deps = {json.dumps(tck["test_runtime"])}, jvm_flags = ["-Dtck.language=sl"])\n'
            for cls in tck["tests"]
        )
        + "truffle_attach(\n"
        + "".join(f"    {key} = {json.dumps(value)},\n" for key, value in attrs.items())
        + ")\n"
    )


def generate(suite, stage):
    directory = stage / suite
    with (directory / "mx-graph.json").open("w") as graph:
        subprocess.run(
            [
                "bazelisk",
                "run",
                "--config=labsjdk",
                "//:mx",
                "--",
                "-p",
                str(directory),
                "bazel-buildfile",
                "--gazelle",
                "--classpath-dists",
                "--release",
                "21",
                *shading_inputs(directory)[1],
                *harness_options(directory),
                *SUITES[suite],
            ],
            cwd=ROOT,
            check=True,
            stdout=graph,
            env={**os.environ, "MX_CACHE_DIR": str(stage / ".mx-cache")},
        )
    if (stage / ".mx-cache").exists() and any(
        p.is_file() for p in (stage / ".mx-cache").rglob("*")
    ):
        raise RuntimeError(
            "Graph discovery unexpectedly populated the mx artifact cache"
        )
    # An implicit Bazel test_suite includes the generated JUnit targets in
    # this package, so new test classes join the CI qualification on regeneration.
    if suite == "sdk":
        (directory / "BUILD.bazel").write_text(
            sdk_native_projects(directory)
            + 'test_suite(name = "tests", visibility = ["//visibility:public"])\n'
        )
    elif suite == "compiler":
        (directory / "BUILD.bazel").write_text(
            library_rules(suite)
            + compiler_harness(directory)
            + qualified_tests(directory)
            + 'load("@rules_mx//graal:simplelanguage.bzl", "simplelanguage")\n'
            'simplelanguage(name = "sl_jit", compiler = ":GRAAL")\n\n'
            'simplelanguage(name = "sl_compilation_test", compiler = ":GRAAL", probe = "@rules_mx//graal:compiled_guest")\n'
        )
    elif suite == "truffle":
        (directory / "BUILD.bazel").write_text(
            "".join(
                f"# gazelle:resolve java {pkg} {label}\n"
                for pkg, label in {
                    "com.oracle.truffle.api.impl": "//truffle:com.oracle.truffle.api",
                    "com.oracle.truffle.api.impl.asm": "//truffle:com.oracle.truffle.api.impl.asm",
                    "org.graalvm.collections": "//sdk:COLLECTIONS",
                    "org.graalvm.nativeimage": "//sdk:NATIVEIMAGE",
                    "org.graalvm.polyglot": "//sdk:POLYGLOT",
                }.items()
            )
            + "\n"
            + library_rules(suite)
            + qualified_tests(directory)
            + truffle_native_projects(directory)
        )
    subprocess.run(
        [
            "bazelisk",
            "run",
            "//:gazelle",
            "--",
            "-repo_root=" + str(stage),
            f"-mx_graph={suite}/mx-graph.json",
            str(directory),
        ],
        cwd=ROOT,
        check=True,
    )
    patch = []
    for build in sorted(directory.rglob("BUILD.bazel")):
        path = build.relative_to(stage).as_posix()
        patch.append(f"diff --git a/{path} b/{path}\nnew file mode 100644\n")
        patch.extend(
            difflib.unified_diff(
                [],
                build.read_text().splitlines(True),
                fromfile="/dev/null",
                tofile="b/" + path,
            )
        )
    return "".join(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "graal",
        nargs="?",
        type=Path,
        help="Graal checkout (defaults to the pinned archive)",
    )
    parser.add_argument(
        "--check", action="store_true", help="compare with the checked-in overlay"
    )
    args = parser.parse_args()
    with tempfile.TemporaryDirectory() as temp:
        stage = Path(temp).resolve()
        source = args.graal
        if source is None:
            location = subprocess.check_output(
                ["bazelisk", "query", "--output=location", "@graal//sdk:BUILD.bazel"],
                cwd=ROOT,
                text=True,
            )
            filename = location.split(": source file ", 1)[0].rsplit(":", 2)[0]
            source = Path(filename).parents[1]
        (stage / ".mx_vcs_root").touch()
        (stage / "WORKSPACE").touch()
        (stage / "BUILD.bazel").write_text(
            "# gazelle:map_kind java_library elide_java_library @rules_mx//mx:java.bzl\n"
        )
        for suite in SUITES:
            for directory in (f"mx.{suite}", "src"):
                rel = Path(suite) / directory
                shutil.copytree(
                    source / rel,
                    stage / rel,
                    ignore=shutil.ignore_patterns(
                        "BUILD", "BUILD.bazel", "__pycache__"
                    ),
                )
        hsdis = ROOT / "graal/hsdis.json"
        pins = (
            json.dumps(hsdis_inputs(stage / "compiler"), indent=2, sort_keys=True)
            + "\n"
        )
        if args.check:
            if hsdis.read_text() != pins:
                sys.exit("Regenerate the HSDIS pins with tools/generate-graal")
        else:
            hsdis.write_text(pins)
        lock = ROOT / "graal/shaded_inputs.json"
        lock_text = (
            json.dumps(
                {
                    k: v
                    for suite in SUITES
                    for k, v in shading_inputs(stage / suite)[0].items()
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
        if args.check:
            if lock.read_text() != lock_text:
                sys.exit(
                    "Shaded dependency pins differ. Regenerate with tools/generate-graal."
                )
        else:
            lock.write_text(lock_text)
        for suite in SUITES:
            overlay = ROOT / f"graal/{suite}.patch"
            patch = generate(suite, stage)
            if args.check:
                if overlay.read_text() != patch:
                    sys.exit(
                        f"{suite} overlay differs. Regenerate it with tools/generate-graal."
                    )
            else:
                overlay.write_text(patch)


if __name__ == "__main__":
    main()
