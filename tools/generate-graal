#!/usr/bin/env python3
"""Generate Graal suite overlays in a temporary tree with mx and Gazelle."""

import argparse
import base64
import difflib
import json
import runpy
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
SDK = [
    "org.graalvm.collections.test",
    "org.graalvm.word.test",
    "org.graalvm.nativeimage.test",
    "NATIVEIMAGE_LIBGRAAL",
    "GRAAL_SDK",
    "WEBIMAGE_PREVIEW",
    "org.graalvm.polyglot.tck",
    "RESOURCECOPY",
    "org.graalvm.home.test",
    "NATIVEBRIDGE_PROCESSOR_TEST",
    "NATIVEBRIDGE_BENCHMARK",
    "NATIVEBRIDGE_PROCESSOR",
    "MAVEN_DOWNLOADER",
    "org.graalvm.launcher.test",
    "LAUNCHER_COMMON",
    "VMACCESS_GUEST",
    "SDK_TEST",
    "POLYGLOT_TCK",
]


SUITES = {
    "sdk": [
        "--whole-project",
        "org.graalvm.nativeimage.libgraal",
        "--java-dep",
        "mx:JUNIT=@contrib_rules_jvm_deps//:junit_junit",
        "--java-dep",
        "mx:HAMCREST=@contrib_rules_jvm_deps//:org_hamcrest_hamcrest_core",
        # These callbacks detach threads and release JNI handles for their side effects.
        "--javac-opt",
        "org.graalvm.nativebridge=-Xep:ReturnValueIgnored:OFF",
        # JLine 3.28 uses explicit type arguments on Comparator.thenComparingInt.
        "--javac-opt",
        "org.graalvm.shadowed.org.jline=-Xep:UnnecessaryTypeArgument:OFF",
        *(
            arg
            for dist in (
                "WORD",
                "NATIVEIMAGE",
                "COLLECTIONS",
                "JNIUTILS",
                "NATIVEBRIDGE",
                "NATIVEBRIDGE_PROCESSOR",
                "NATIVEBRIDGE_PROCESSOR_TEST",
                "NATIVEBRIDGE_BENCHMARK",
                "JLINE3",
                "POLYGLOT",
                "LAUNCHER_COMMON",
                "POLYGLOT_TCK",
                "SDK_TEST",
                "VMACCESS_GUEST",
                "GRAAL_SDK",
                "NATIVEIMAGE_LIBGRAAL",
                "WEBIMAGE_PREVIEW",
                "MAVEN_DOWNLOADER",
                "RESOURCECOPY",
            )
            for arg in ("--archive-dist", dist)
        ),
        *SDK,
    ],
    "truffle": [
        "--infer-source-deps",
        "--generated-dep",
        "truffle:com.oracle.truffle.api.exception=:com.oracle.truffle.api.dsl",
        "--generated-dep",
        "truffle:com.oracle.truffle.api.bytecode=:com.oracle.truffle.api.utilities",
        "--java-dep",
        "sdk:VERSION=//sdk:VERSION",
        "--java-dep",
        "sdk:NATIVEIMAGE=//sdk:NATIVEIMAGE",
        "--java-dep",
        "sdk:COLLECTIONS=//sdk:COLLECTIONS",
        "--java-dep",
        "sdk:POLYGLOT=//sdk:POLYGLOT",
        "--java-dep",
        "truffle:ANTLR4=@contrib_rules_jvm_deps//:org_antlr_antlr4_runtime_4_13_2",
        "--javac-only-processor",
        "truffle:TRUFFLE_DSL_PROCESSOR",
        "--java-dep",
        "sdk:NATIVEBRIDGE=//sdk:NATIVEBRIDGE",
        "--processor-plugin",
        "sdk:NATIVEBRIDGE_PROCESSOR=//sdk:mx_plugin.NATIVEBRIDGE_PROCESSOR.org.graalvm.nativebridge.processor.NativeBridgeProcessor",
        "com.oracle.truffle.api.library",
        "com.oracle.truffle.polyglot",
        "TRUFFLE_API_VERSION",
    ],
}


SHADED_PROJECTS = {
    "sdk": ("org.graalvm.shadowed.org.jline", "org.graalvm.shadowed.org.jline.jdk22"),
    "truffle": ("com.oracle.truffle.api.impl.asm",),
}


def shading_inputs(directory):
    suite = runpy.run_path(str(directory / f"mx.{directory.name}/suite.py"))["suite"]
    inputs = {}
    flags = []
    for project in SHADED_PROJECTS[directory.name]:
        for qualified in suite["projects"][project]["shadedDependencies"]:
            owner, name = qualified.split(":")
            if owner != directory.name:
                raise ValueError(f"Unmapped external shaded library {qualified}")
            lib = suite["libraries"][name]
            mvn = lib["maven"]
            artifact, version = mvn["artifactId"], mvn["version"]
            base = f"{mvn['groupId'].replace('.', '/')}/{artifact}/{version}/{artifact}-{version}"
            for suffix, key in [("", "digest"), ("-sources", "sourceDigest")]:
                filename = qualified.replace(":", "_") + suffix + ".jar"
                algo, digest = lib[key].split(":")
                inputs[filename] = [
                    base + suffix + ".jar",
                    algo + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
                ]
                flags.extend(
                    ["--shaded-input", f"{qualified}=@graal_shaded_inputs//:{filename}"]
                )
    return inputs, flags


def sdk_native_projects(sdk):
    suite = runpy.run_path(str(sdk / "mx.sdk/suite.py"))["suite"]
    name = "org.graalvm.nativebridge.launcher"
    resource = "NATIVEBRIDGE_LAUNCHER_RESOURCES"
    project = suite["projects"][name]
    layout = suite["distributions"][resource]
    if (
        layout["layout"] != {"<os>/<arch>/": "dependency:" + name}
        or not project["use_jdk_headers"]
        or project["native"] != "executable"
    ):
        raise ValueError("Native Bridge launcher layout or project type changed")
    src = sdk / project["subDir"] / name / "src"
    platforms = {os: arch["<others>"] for os, arch in project["os_arch"].items()}
    attrs = dict(
        name=name,
        deliverable=project["deliverable"],
        srcs=sorted(p.relative_to(sdk).as_posix() for p in src.rglob("*.cc")),
        cflags={os: cfg["cflags"] for os, cfg in platforms.items()},
        ldlibs={os: cfg.get("ldlibs", []) for os, cfg in platforms.items()},
        resource=resource,
        platforms=layout["platforms"],
    )
    probe = "org.graalvm.toolchain.test"
    probe_project = suite["projects"][probe]
    if probe_project["class"] != "ToolchainTestProject" or probe_project[
        "buildDependencies"
    ] != ["LLVM_TOOLCHAIN"]:
        raise ValueError("SDK toolchain test contract changed")
    probe_sources = [
        f"{probe_project['subDir']}/{probe}/{src}" for src in ("hello.c", "hello.cc")
    ]
    return (
        'load("@rules_mx//graal:nativebridge.bzl", "nativebridge_launcher")\n'
        'load("@rules_mx//graal:toolchain_test.bzl", "sdk_toolchain_test")\n\n'
        + f'sdk_toolchain_test(name = "{probe}", sources = {json.dumps(probe_sources)})\n\n'
        + "nativebridge_launcher(\n"
        + "".join(f"    {key} = {json.dumps(value)},\n" for key, value in attrs.items())
        + ")\n\n"
    )


def generate(suite, stage):
    directory = stage / suite
    with (directory / "mx-graph.json").open("w") as graph:
        subprocess.run(
            [
                "bazelisk",
                "run",
                "--config=labsjdk",
                "//:mx",
                "--",
                "-p",
                str(directory),
                "bazel-buildfile",
                "--gazelle",
                "--classpath-dists",
                "--release",
                "21",
                *shading_inputs(directory)[1],
                *SUITES[suite],
            ],
            cwd=ROOT,
            check=True,
            stdout=graph,
        )
    # An implicit Bazel test_suite includes the generated JUnit targets in
    # this package, so new test classes join the CI qualification on regeneration.
    if suite == "sdk":
        (directory / "BUILD.bazel").write_text(
            sdk_native_projects(directory)
            + 'test_suite(name = "tests", visibility = ["//visibility:public"])\n'
        )
    subprocess.run(
        [
            "bazelisk",
            "run",
            "//:gazelle",
            "--",
            "-repo_root=" + str(stage),
            f"-mx_graph={suite}/mx-graph.json",
            str(directory),
        ],
        cwd=ROOT,
        check=True,
    )
    patch = []
    for build in sorted(directory.rglob("BUILD.bazel")):
        path = build.relative_to(stage).as_posix()
        patch.append(f"diff --git a/{path} b/{path}\nnew file mode 100644\n")
        patch.extend(
            difflib.unified_diff(
                [],
                build.read_text().splitlines(True),
                fromfile="/dev/null",
                tofile="b/" + path,
            )
        )
    return "".join(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "graal",
        nargs="?",
        type=Path,
        help="Graal checkout (defaults to the pinned archive)",
    )
    parser.add_argument(
        "--check", action="store_true", help="compare with the checked-in overlay"
    )
    args = parser.parse_args()
    with tempfile.TemporaryDirectory() as temp:
        stage = Path(temp).resolve()
        source = args.graal
        if source is None:
            location = subprocess.check_output(
                ["bazelisk", "query", "--output=location", "@graal//sdk:BUILD.bazel"],
                cwd=ROOT,
                text=True,
            )
            filename = location.split(": source file ", 1)[0].rsplit(":", 2)[0]
            source = Path(filename).parents[1]
        (stage / ".mx_vcs_root").touch()
        (stage / "WORKSPACE").touch()
        (stage / "BUILD.bazel").write_text(
            "# gazelle:map_kind java_library elide_java_library @rules_mx//mx:java.bzl\n"
        )
        for suite in SUITES:
            for directory in (f"mx.{suite}", "src"):
                rel = Path(suite) / directory
                shutil.copytree(
                    source / rel,
                    stage / rel,
                    ignore=shutil.ignore_patterns(
                        "BUILD", "BUILD.bazel", "__pycache__"
                    ),
                )
        lock = ROOT / "graal/shaded_inputs.json"
        lock_text = (
            json.dumps(
                {
                    k: v
                    for suite in SUITES
                    for k, v in shading_inputs(stage / suite)[0].items()
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
        if args.check:
            if lock.read_text() != lock_text:
                sys.exit(
                    "Shaded dependency pins differ. Regenerate with tools/generate-graal."
                )
        else:
            lock.write_text(lock_text)
        for suite in SUITES:
            overlay = ROOT / f"graal/{suite}.patch"
            patch = generate(suite, stage)
            if args.check:
                if overlay.read_text() != patch:
                    sys.exit(
                        f"{suite} overlay differs. Regenerate it with tools/generate-graal."
                    )
            else:
                overlay.write_text(patch)


if __name__ == "__main__":
    main()
