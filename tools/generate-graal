def declared(directory):
    """Names of the projects, distributions and libraries in a staged suite."""
    suite = runpy.run_path(str(directory / f"mx.{directory.name}/suite.py"))["suite"]
    return {
        name
        for kind in ("projects", "distributions", "libraries")
        for name in suite.get(kind, {})
    }


def missing(directory):
    """Optional selections whose required declaration the staged suite lacks."""
    available = declared(directory)
    return {
        name
        for name, needed in OPTIONAL.get(directory.name, {}).items()
        if needed not in available
    }


def present(directory, names):
    """Keep the names that the staged suite supports."""
    absent = missing(directory)
    return [n for n in names if n not in absent]


def suite_args(directory):
    """SUITES arguments for a staged suite, without unsupported optional selections."""
    absent = missing(directory)
    args = []
    for arg in SUITES[directory.name]:
        if arg.split("=", 1)[0].rpartition(":")[2] in absent:
            if args and args[-1].startswith("--") and args[-1] not in FLAGS:
                args.pop()
            continue
        args.append(arg)
    return args


def maven_pin(lib, suffix="", key="digest"):
    mvn = lib["maven"]
    artifact, version = mvn["artifactId"], mvn["version"]
    path = f"{mvn['groupId'].replace('.', '/')}/{artifact}/{version}/{artifact}-{version}{suffix}.jar"
    algorithm, digest = lib[key].split(":")
    return [path, algorithm + "-" + base64.b64encode(bytes.fromhex(digest)).decode()]


def mx_library_rules(directory, roots):
    libraries = runpy.run_path(str(directory.parent / "mx-suite.py"))["suite"][
        "libraries"
    ]
    pins, flags, rules = {}, [], []

    def add(name):
        filename = f"mx_{name}.jar"
        if filename in pins:
            return
        lib = libraries[name]
        pins[filename] = maven_pin(lib)
        dependencies = lib.get("dependencies", [])
        deps = [":" + dep for dep in dependencies]
        flags.extend(["--java-dep", f"mx:{name}=:{name}"])
        rules.append(
            f'java_import(name = "{name}", jars = ["@graal_shaded_inputs//:{filename}"], deps = {json.dumps(deps)})'
        )

        for dep in dependencies:
            add(dep)

    for name in roots:
        add(name)
    return pins, flags, rules


def jmh_rules(directory):
    pins, _, rules = mx_library_rules(directory, ["JMH_1_21"])
    rules.insert(0, 'load("@rules_java//java:java_plugin.bzl", "java_plugin")')
    rules.append(
        'java_plugin(name = "jmh_processor", processor_class = "org.openjdk.jmh.generators.BenchmarkProcessor", deps = [":JMH_1_21"])'
    )
    return pins, "\n".join(rules) + "\n"


def library_rules(directory):
    suite = directory.name
    names = present(directory, JAVA_LIBRARIES[suite])
    if not names:
        return ""
    metadata = runpy.run_path(str(directory / f"mx.{suite}/suite.py"))["suite"][
        "libraries"
    ]
    deps = {
        n: [":" + d for d in metadata[n].get("dependencies", []) if d in names]
        for n in names
    }
    return 'load("@rules_java//java:java_import.bzl", "java_import")\n' + "".join(
        f'java_import(name = "{name}", jars = ["@graal_shaded_inputs//:{suite}_{name}.jar"]{", deps = " + json.dumps(deps[name]) if deps[name] else ""}, visibility = ["//visibility:public"])\n'
        for name in names
    )


def harness_options(directory):
    suite = directory.name
    metadata = runpy.run_path(str(directory / f"mx.{suite}/suite.py"))["suite"]
    if suite == "truffle":
        projects = metadata["distributions"]["TRUFFLE_TEST"]["dependencies"]
        return [
            arg
            for p in projects
            for arg in (
                "--test-launcher",
                f"truffle:{p}=:truffle_junit",
                "--generated-dep",
                f"truffle:{p}=@contrib_rules_jvm_deps//:org_hamcrest_hamcrest_core",
                "--manual-test-project",
                p,
            )
        ]
    if suite in ("compiler", "regex", "tools"):
        service = (
            directory.parent
            / "truffle/src/com.oracle.truffle.dsl.processor/src/META-INF/services/javax.annotation.processing.Processor"
        )
        processors = [
            arg
            for proc in service.read_text().splitlines()
            if proc.strip() and not proc.startswith("#")
            for arg in (
                "--processor-plugin",
                f"truffle:TRUFFLE_DSL_PROCESSOR=//truffle:mx_plugin.TRUFFLE_DSL_PROCESSOR.{proc}",
            )
        ]
        if suite in ("regex", "tools"):
            return processors
        return [
            "--test-launcher",
            "compiler:jdk.graal.compiler.test=:compiler_junit",
            "--generated-dep",
            "compiler:jdk.graal.compiler.test=@contrib_rules_jvm_deps//:org_hamcrest_hamcrest_core",
            "--manual-test-project",
            "jdk.graal.compiler.test",
            *processors,
        ]
    if suite == "substratevm":
        source = (
            directory.parent
            / "compiler/src/jdk.graal.compiler.processor/src"
            / "META-INF/services/javax.annotation.processing.Processor"
        )
        pending = [
            *present(directory, SVM_SUPPORT_JARS),
            *present(directory, SVM_TEST_JARS),
            *SVM_STANDALONE_PROJECTS,
            "SVM",
            "SVM_DRIVER",
            "LIBRARY_SUPPORT",
            "SVM_GUEST",
            "SVM_JVMCI_GUEST",
        ]
        service = (
            directory.parent
            / "truffle/src/com.oracle.truffle.dsl.processor/src/META-INF/services/javax.annotation.processing.Processor"
        )
        truffle_processors = [
            arg
            for name in service.read_text().splitlines()
            if name.strip() and not name.startswith("#")
            for arg in (
                "--processor-plugin",
                f"truffle:TRUFFLE_DSL_PROCESSOR=//truffle:mx_plugin.TRUFFLE_DSL_PROCESSOR.{name}",
            )
        ]
        args = SUITES["substratevm"]
        seen = set()
        # Projects with an explicit release in SUITES keep it.
        explicit = {
            value.split("=", 1)[0]
            for option, value in zip(args, args[1:])
            if option == "--project-release"
        }
        # Distributions bound to existing labels contribute no projects to this export.
        bound = {
            value.split("=", 1)[0].removeprefix("substratevm:")
            for option, value in zip(args, args[1:])
            if option == "--java-dep"
        }
        releases = []
        while pending:
            name = pending.pop()
            if name in seen or name in bound:
                continue
            seen.add(name)
            if project := metadata["projects"].get(name):
                if project.get("javaCompliance") == "24+" and name not in explicit:
                    releases.extend(("--project-release", name + "=24"))
                pending.extend(project.get("dependencies", []))
            elif dist := metadata["distributions"].get(name):
                pending.extend(
                    dist.get("dependencies", []) + dist.get("distDependencies", [])
                )
        return [
            *releases,
            *truffle_processors,
            *[
                arg
                for proc in source.read_text().splitlines()
                if proc.strip() and not proc.startswith("#")
                for arg in (
                    "--processor-plugin",
                    f"compiler:GRAAL_PROCESSOR=//compiler:mx_plugin.GRAAL_PROCESSOR.{proc}",
                )
            ],
        ]
    return []


def shading_inputs(directory):
    suite = runpy.run_path(str(directory / f"mx.{directory.name}/suite.py"))["suite"]
    inputs = {}
    flags = []
    if directory.name == "truffle":
        inputs.update(jmh_rules(directory)[0])
    if directory.name == "web-image":
        pins, bindings, _ = mx_library_rules(directory, ["JUNIT-JUPITER-API"])
        inputs.update(pins)
        flags.extend(bindings)
    for project in SHADED_PROJECTS.get(directory.name, ()):
        for qualified in suite["projects"][project]["shadedDependencies"]:
            owner, _, name = qualified.rpartition(":")
            owner = owner or directory.name
            qualified = f"{owner}:{name}"
            owner_suite = (
                suite
                if owner == directory.name
                else runpy.run_path(
                    str(directory.parent / owner / f"mx.{owner}/suite.py")
                )["suite"]
            )
            lib = owner_suite["libraries"][name]
            for suffix, key in [("", "digest"), ("-sources", "sourceDigest")]:
                filename = qualified.replace(":", "_") + suffix + ".jar"
                inputs[filename] = maven_pin(lib, suffix, key)
                flags.extend(
                    ["--shaded-input", f"{qualified}=@graal_shaded_inputs//:{filename}"]
                )
    for name in present(directory, JAVA_LIBRARIES.get(directory.name, ())):
        lib = suite["libraries"][name]
        if "maven" in lib:
            pin = maven_pin(lib)
        else:
            algorithm, digest = lib["digest"].split(":")
            pin = [
                [url.format(**lib) for url in lib["urls"]],
                algorithm + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
            ]
        inputs[f"{directory.name}_{name}.jar"] = pin
        flags.extend(["--java-dep", f"{directory.name}:{name}=:{name}"])
    if directory.name == "substratevm":
        flags.extend(svm_url_library_rules(directory)[1])
    return inputs, flags


