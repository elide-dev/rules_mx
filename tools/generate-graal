def shading_inputs(directory):
    suite = runpy.run_path(str(directory / f"mx.{directory.name}/suite.py"))["suite"]
    inputs = {}
    flags = []
    for project in SHADED_PROJECTS.get(directory.name, ()):
        for qualified in suite["projects"][project]["shadedDependencies"]:
            owner, name = qualified.split(":")
            if owner != directory.name:
                raise ValueError(f"Unmapped external shaded library {qualified}")
            lib = suite["libraries"][name]
            mvn = lib["maven"]
            artifact, version = mvn["artifactId"], mvn["version"]
            base = f"{mvn['groupId'].replace('.', '/')}/{artifact}/{version}/{artifact}-{version}"
            for suffix, key in [("", "digest"), ("-sources", "sourceDigest")]:
                filename = qualified.replace(":", "_") + suffix + ".jar"
                algo, digest = lib[key].split(":")
                inputs[filename] = [
                    base + suffix + ".jar",
                    algo + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
                ]
                flags.extend(
                    ["--shaded-input", f"{qualified}=@graal_shaded_inputs//:{filename}"]
                )
    for name in JAVA_LIBRARIES.get(directory.name, ()):
        lib = suite["libraries"][name]
        mvn = lib["maven"]
        artifact, version = mvn["artifactId"], mvn["version"]
        path = f"{mvn['groupId'].replace('.', '/')}/{artifact}/{version}/{artifact}-{version}.jar"
        algo, digest = lib["digest"].split(":")
        inputs[f"{directory.name}_{name}.jar"] = [
            path,
            algo + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
        ]
        flags.extend(["--java-dep", f"{directory.name}:{name}=:{name}"])
    return inputs, flags


def hsdis_inputs(directory):
    suite = runpy.run_path(str(directory / "mx.compiler/suite.py"))["suite"]
    library = suite["libraries"]["HSDIS"]
    layouts = suite["distributions"]["HSDIS_LIBRARY"]["os_arch"]
    pins = {}
    for os_name, arch in (
        ("darwin", "aarch64"),
        ("linux", "amd64"),
        ("linux", "aarch64"),
    ):
        config = library["os_arch"][os_name][arch]
        ((output, source),) = layouts[os_name]["<others>"]["layout"].items()
        if source != "file:<path:HSDIS>/*":
            raise ValueError("Unsupported HSDIS layout")
        algo, digest = config["digest"].split(":")
        (url,) = config["urls"]
        pins[f"{os_name}_{arch}"] = dict(
            url=url.format(urlbase=library["urlbase"]),
            integrity=algo + "-" + base64.b64encode(bytes.fromhex(digest)).decode(),
            output=output.replace("<arch>", arch),
        )
    return pins


