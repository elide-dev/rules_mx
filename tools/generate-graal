        if "layout" in dist and name != "TRUFFLE_API_VERSION"
    }


def truffle_distribution_layouts(directory, suite):
    native_project = "com.oracle.truffle.nfi.native"
    header_dir = "src/" + native_project + "/include"
    headers = sorted(directory.glob(header_dir + "/*.h"))
    dependencies = {
        "libffi/*": [
            (":libffi_archive", "{target}/libffi.a"),
            ("@graal_libffi//:ffi_distribution_header", "{target}/include/ffi.h"),
            (
                "@graal_libffi//:ffitarget_distribution_header",
                "{target}/include/ffitarget.h",
            ),
        ],
        "com.oracle.truffle.attach": [
            (":com.oracle.truffle.attach", "{basename}"),
        ],
        native_project + "/*": [
            (":" + native_project, "{target}/{basename}"),
            *(
                (p.relative_to(directory).as_posix(), "include/" + p.name)
                for p in headers
            ),
        ],
        native_project + "/include/*.h": [
            (p.relative_to(directory).as_posix(), p.name) for p in headers
        ],
        native_project + "/*/<multitarget_libc_selection>/*": [
            (":" + native_project, "{basename}"),
        ],
        "nfi-native": [(":nfi-native", "{basename}")],
    }
    rules = [
        'load("@rules_mx//graal:layout.bzl", "mx_archive_layout", "static_archive")',
        'static_archive(name = "libffi_archive", library = "@graal_libffi//:libffi")',
    ]
    platforms = suite["distributions"]["TRUFFLE_NFI_NATIVE"]["platforms"]
    prefixes = {}
    for platform in platforms:
        os, arch = platform.split("-")
        constraints = [
            "@platforms//os:" + {"darwin": "macos"}.get(os, os),
            "@platforms//cpu:" + {"amd64": "x86_64"}.get(arch, arch),
        ]
        label = "layout." + platform
        rules.append(
            f'config_setting(name = "{label}", constraint_values = {json.dumps(constraints)})'
        )
        prefixes[":" + label] = (
            platform + "/" + ("glibc" if os == "linux" else "default")
        )
    for name, dist in truffle_layout_distributions(suite).items():
        if name in ("TRUFFLE_ATTACH_RESOURCES", "TRUFFLE_NFI_RESOURCES"):
            continue
        entries = []
        for dest, sources in dist["layout"].items():
            for source in sources if isinstance(sources, list) else [sources]:
                kind, spec = source.split(":", 1)
                if kind == "file":
                    files = [
                        (p.relative_to(directory).as_posix(), p.name)
                        for p in sorted(directory.glob(spec))
                        if p.is_file()
                    ]
                elif kind == "dependency":
                    files = dependencies[spec]
                else:
                    raise ValueError(f"Unsupported layout source {source} in {name}")
                if not files or (not dest.endswith("/") and len(files) != 1):
                    raise ValueError(f"Unexpected files for {source} in {name}")
                entries.extend(
                    (
                        label,
                        (dest.removeprefix("./") + member)
                        if dest.endswith("/")
                        else dest,
                    )
                    for label, member in files
                )
        options = ""
        if any("{target}" in dest for _, dest in entries):
            options += f", target_prefix = select({json.dumps(prefixes)})"
        if name == "PMH_BENCHMARK_NATIVE":
            options += ", testonly = True"
        if name in (
            "LIBFFI_DIST",
            "TRUFFLE_NFI_NATIVE",
            "TRUFFLE_NFI_NATIVE_GRAALVM_SUPPORT",
            "PMH_BENCHMARK_NATIVE",
        ):
            options += ', target_compatible_with = select({"@platforms//os:linux": [], "@platforms//os:macos": [], "//conditions:default": ["@platforms//:incompatible"]})'
        members = {}
        for label, destination in entries:
            members.setdefault(label, []).append(destination)
        members = {label: "\n".join(paths) for label, paths in members.items()}
        format = dist.get("type", "tar" if dist.get("native") else "jar")
        rules.append(
            f'mx_archive_layout(name = "{name}", format = "{format}", members = {json.dumps(members)}'
            f'{options}, visibility = ["//visibility:public"])'
        )
    inventory = sorted(":" + name for name in suite["distributions"])
    rules.append(
        f'filegroup(name = "all_distributions", srcs = {json.dumps(inventory)}, testonly = True, visibility = ["//visibility:public"])'
    )
    return "\n".join(rules) + "\n"


def truffle_native_projects(directory):
    suite = runpy.run_path(str(directory / "mx.truffle/suite.py"))["suite"]
    name = "com.oracle.truffle.attach"
    resource = "TRUFFLE_ATTACH_RESOURCES"
    project = suite["projects"][name]
    dist = suite["distributions"][resource]
    [(destination, source)] = dist["layout"].items()
    if (
        source != "dependency:" + name
        or project["native"] != "shared_lib"
        or not project["use_jdk_headers"]
        or project["buildDependencies"]
    ):
        raise ValueError("Unsupported Truffle attach project or resource layout")
    src = directory / project["subDir"] / name / "src"
    attrs = dict(
        name=name,
        resource=resource,
        deliverable=project["deliverable"],
        srcs=sorted(p.relative_to(directory).as_posix() for p in src.rglob("*.c")),
        cflags={os: a["<others>"]["cflags"] for os, a in project["os_arch"].items()},
        ldlibs={
            os: a["<others>"].get("ldlibs", []) for os, a in project["os_arch"].items()
        },
        platforms=dist["platforms"],
        destination=destination,
        file_list=dist["fileListEntry"],
        hash_entry=dist["hashEntry"],
    )
    native = "com.oracle.truffle.nfi.native"
    test = suite["distributions"]["TRUFFLE_TEST_NATIVE"]
    nfi = suite["distributions"]["TRUFFLE_NFI_RESOURCES"]
    [(dest, member)] = nfi["layout"].items()
    if member != f"dependency:{native}/*/<multitarget_libc_selection>/*":
        raise ValueError("Unsupported NFI internal-resource layout")
    projects = []
    for project_name in [native, *test["dependencies"]]:
        project = suite["projects"][project_name]
        if project["native"] != "shared_lib":
            raise ValueError(f"Expected a shared library for {project_name}")
        sources = directory / project["subDir"] / project_name / "src"
        projects.append(
            dict(
                name=project_name,
                deliverable=project["deliverable"],
                os_arch=project["os_arch"],
                sources=sorted(
                    p.relative_to(directory).as_posix()
                    for p in sources.iterdir()
                    if p.suffix in {".c", ".cc", ".h"}
                ),
            )
        )
    header = directory / "src" / native / "src/native.h"
    nfi_attrs = dict(
        name=native,
        projects=projects,
        headers=re.findall(r'^#include "(.*?\.h)"', header.read_text(), re.M),
        platforms=nfi["platforms"],
        destination=dest,
        file_list=nfi["fileListEntry"],
        hash_entry=nfi["hashEntry"],
    )
    bench = suite["projects"]["nfi-native"]
    header_flag = "-I<path:truffle:TRUFFLE_NFI_GRAALVM_SUPPORT>/include"
    if (
        bench["buildDependencies"] != ["TRUFFLE_NFI_GRAALVM_SUPPORT"]
        or header_flag not in bench["cflags"]
    ):
        raise ValueError("Unknown NFI benchmark header layout")
    bench_dir = directory / bench["subDir"] / "nfi-native/src"
    nfi_attrs["benchmark"] = dict(
        name="nfi-native",
        deliverable=bench["deliverable"],
        sources=sorted(
            p.relative_to(directory).as_posix() for p in bench_dir.glob("*.c")
        ),
        os_arch={
            "<others>": {
                "<others>": {"cflags": [f for f in bench["cflags"] if f != header_flag]}
            }
        },
    )
    inventory = sorted(":" + name for name in suite["projects"])
    fixture_rules = []
    fixture_root = directory / "src/com.oracle.truffle.sl.test/src/tests"
    for parent in sorted({p.parent for p in fixture_root.rglob("*.sl")}):
        (parent / "BUILD.bazel").write_text(
            'exports_files(glob(["*.sl", "*.output", "*.input"], allow_empty = True), visibility = ["//truffle:__pkg__"])\n'
        )
        names = sorted(p.stem for p in parent.glob("*.sl"))
        inputs = sorted(p.stem for p in parent.glob("*.input"))
        prefix = ".".join(parent.relative_to(fixture_root).parts)
        package = "//" + parent.relative_to(directory.parent).as_posix()
        fixture_rules.append(
            f"sl_fixture_tests(package = {json.dumps(package)}, names = {json.dumps(names)}, "
            f"inputs = {json.dumps(inputs)}, prefix = {json.dumps(prefix + '.' if prefix else '')})\n"
        )
    projects = json.loads((directory / "mx-graph.json").read_text())["projects"]
    tck = next(p for p in projects if p["name"] == "com.oracle.truffle.tck.tests")
    nfi_tests = next(p for p in projects if p["name"] == "com.oracle.truffle.nfi.test")
    return (
        'load("@rules_mx//graal:attach.bzl", "truffle_attach")\n\n'
        + 'load("@rules_mx//graal:simplelanguage.bzl", "modular_test_runner", "optimizing_junit", "panama_test", "simplelanguage", "sl_fixture_tests", "truffle_test_runner")\n'
        + 'truffle_test_runner(name = "truffle_junit", jvm_flags = ['
        + '"--enable-native-access=ALL-UNNAMED", "--add-exports=java.base/jdk.internal.module=ALL-UNNAMED", '
        + '"-Dpolyglot.engine.WarnInterpreterOnly=false", '
        # mx's Truffle unittest configuration keeps the expensive assertions enabled.
        + '"-Dtruffle.DetailedAssertions=true", '
        + '"-Dpolyglot.ConstantOptionsLanguage.ConstantOption1=configuredValue"])\n'
        + 'modular_test_runner(name = "modular_junit")\n'
        + "".join(
            f'panama_test(name = "panama.{cls.rsplit(".", 1)[-1]}", test_class = "{cls}")\n'
            for cls in nfi_tests["tests"]
        )
        + 'simplelanguage(name = "sl")\n\n'
        + "".join(fixture_rules)
        + "".join(
            f'optimizing_junit(name = "sl_jit.tck.{cls.rsplit(".", 1)[1]}", test_class = "{cls}", '
            f'runtime_deps = {json.dumps(tck["test_runtime"])}, jvm_flags = ["-Dtck.language=sl"])\n'
            for cls in tck["tests"]
        )
        + 'load("@rules_mx//graal:nfi.bzl", "nfi_libraries")\n'
        + "nfi_libraries(\n"
        + "".join(
            f"    {key} = {json.dumps(value)},\n" for key, value in nfi_attrs.items()
        )
        + ")\n"
        + f'filegroup(name = "all_projects", srcs = {json.dumps(inventory)}, testonly = True, visibility = ["//visibility:public"])\n'
        + truffle_distribution_layouts(directory, suite)
        + "truffle_attach(\n"
        + "".join(f"    {key} = {json.dumps(value)},\n" for key, value in attrs.items())
        + ")\n"
    )


def espresso_shared_rules(directory):
    suite = runpy.run_path(str(directory / "mx.espresso-shared/suite.py"))["suite"]
    project = suite["projects"]["com.oracle.svm.espresso"]
    annotation_patches = {}
    for annotation in project["removeAnnotations"]:
        pkg, type_name = re.split(r"\.(?=[A-Z])", annotation, maxsplit=1)
        type_parts = type_name.split(".")
        imports = [annotation]
        if len(type_parts) > 1:
            imports += [pkg + "." + type_parts[0], "static " + annotation]
        for name in imports:
            annotation_patches[r"^import\s+" + re.escape(name) + r"\s*;"] = ""
        for name in sorted({type_name, type_parts[-1]}):
            annotation_patches[r"@" + re.escape(name) + r"(\(.*?\))?(?!\w)"] = ""
    spec = json.dumps(
        {"packages": project["packageMap"], "patch": {"**/*.java": annotation_patches}},
        sort_keys=True,
    )
    sources = [":" + name for name in project["shadedProjects"]]
    directories = [
        directory / suite["projects"][name]["subDir"] / name / root
        for name in project["shadedProjects"]
        for root in suite["projects"][name]["sourceDirs"]
    ]
    packages = sorted(
        {
            ".".join(p.parent.relative_to(root).parts).replace(old, new, 1)
            for root in directories
            for p in root.rglob("*.java")
            for old, new in project["packageMap"].items()
        }
    )
    module = suite["distributions"]["ESPRESSO_SVM"]["moduleInfo"]
    [export] = module["exports"]
    directives = ["exports " + export.replace("*", pkg) for pkg in packages]
    directives.append("requires org.graalvm.collections")
    return (
        'load("@rules_mx//graal:espresso.bzl", "espresso_svm")\n'
        'espresso_svm(name = "ESPRESSO_SVM", project = "com.oracle.svm.espresso", '
        f"shade = {json.dumps(spec)}, shade_inputs = {json.dumps(sources)}, "
        f"module_name = {json.dumps(module['name'])}, directives = {json.dumps(directives)})\n"
    )


def svm_native_rules(directory):
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    projects = {}
    for name in (
        "libchelper",
        "jvm.posix",
        "libcontainer",
        "darwin",
        "reporterchelper",
        # The heap-blob decoder that images link statically, on revisions that declare it.
        "libzstd",
        # The Windows libjvm replacement, which only Windows targets build.
        "jvm.windows",
    ):
        key = "com.oracle.svm.native." + name
        if key not in suite["projects"]:
            continue
        project = suite["projects"][key]
        options = project.get("os") or {
            os: arches.get("<others>", arches.get("amd64", {}))
            for os, arches in project["os_arch"].items()
        }
        flags = {}
        includes = set()
        # The Windows builds of the shared helpers are not migrated, so only the Windows-only
        # libjvm replacement takes its Windows flags.
        systems = ("windows",) if name == "jvm.windows" else ("linux", "darwin")
        for system in systems:
            target = options.get(system, options.get("<others>", {}))
            if "cflags" in target:
                flags[system] = []
                prefix = "-I<path:" + key + ">/"
                for flag in target["cflags"]:
                    if flag.startswith(prefix):
                        includes.add("src/" + key + "/" + flag.removeprefix(prefix))
                    elif "<path:" in flag:
                        raise ValueError(
                            f"Unsupported path substitution in {key}: {flag}"
                        )
                    else:
                        flags[system].append(flag)
        projects[name] = {
            "deliverable": project.get("deliverable", name.split(".")[-1]),
            "cflags": flags,
            "includes": sorted(includes),
            "jni": project.get("use_jdk_headers", False),
        }
    builder_libs = {}
    if zstd := suite["libraries"].get("ZSTD_JNI"):
        # The builder loads zstd-jni by file name from lib/svm/builder/lib.
        builder_libs[":ZSTD_JNI"] = f"zstd-jni-{zstd['maven']['version']}.jar"
    return (
        'load("@rules_mx//graal:svm.bzl", "svm_launcher", "svm_native_projects")\n'
        f"svm_native_projects(projects = {repr(projects)})\n"
        'svm_launcher(name = "native-image"'
        + (f", builder_libs = {json.dumps(builder_libs)}" if builder_libs else "")
        + ")\n"
        + svm_graalvm_support(directory)
    )


def vm_access_modules(directory):
    # The invariant checks trust interfaces of the named jdk.graal.compiler.vmaccess module
    # and load the host VM access through its service. mx puts both modules on the module
    # path, with the concealed packages they require.
    compiler = runpy.run_path(str(directory.parent / "compiler/mx.compiler/suite.py"))[
        "suite"
    ]
    vm_access = {}
    vmaccess_exports = set()
    for name in ("VMACCESS", "HOSTVMACCESS"):
        dist = compiler["distributions"][name]
        module = dist["moduleInfo"]["name"]
        vm_access[module] = name
        for concealed_packages in [dist["moduleInfo"].get("requiresConcealed", {})] + [
            compiler["projects"][project].get("requiresConcealed", {})
            for project in dist["dependencies"]
            if project in compiler["projects"]
        ]:
            vmaccess_exports.update(
                f"--add-exports={owner}/{package}={module}"
                for owner, packages in concealed_packages.items()
                for package in packages
            )
    return vm_access, sorted(vmaccess_exports)


def svm_test_runners(directory):
    """Launchers for the JVM unit tests, with the flags of their mx unit test configurations."""
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    distributions = suite["distributions"]
    # SVMInvariantsUnittestConfig checks every non-test JAR distribution of the suite.
    checked = [
        ":" + name
        for name, dist in distributions.items()
        if not dist.get("native")
        and "layout" not in dist
        and not dist.get("testDistribution")
    ]
    # mx exports the concealed packages that classpath projects require to ALL-UNNAMED.
    concealed = sorted(
        {
            f"--add-exports={module}/{package}=ALL-UNNAMED"
            for project in suite["projects"].values()
            for module, packages in project.get("requiresConcealed", {}).items()
            if module != "jdk.internal.vm.ci"
            for package in packages
        }
    )
    vm_access, vmaccess_exports = vm_access_modules(directory)
    hosted_flags = [
        "-XX:-UseJVMCICompiler",
        # The mode of the mx gate's "SVM invariants" task.
        "-Dsvm.invariants.VerifyReflectionUsage.mode=check_exclude_list",
        *concealed,
        *sorted(vmaccess_exports),
    ]
    pointsto_flags = [
        "-Djava.util.concurrent.ForkJoinPool.common.threadFactory=com.oracle.graal.pointsto.standalone.StandaloneCommonPoolWorkerThreadFactory",
        # The host VM access; the Espresso variant needs the espresso-compiler-stub suite.
        "-Dcom.oracle.graal.pointsto.standalone.vmaccess.name=host",
        "-Dcom.oracle.graal.pointsto.standalone.test.analysis.option.count=0",
        "--add-exports=jdk.graal.compiler/jdk.graal.compiler.phases.util=ALL-UNNAMED",
        *concealed,
    ]
    return (
        'load("@rules_mx//graal:simplelanguage.bzl", "svm_test_runner")\n'
        f'svm_test_runner(name = "svm_hosted_junit", test_classpath = [":SVM_HOSTED_TESTS"], jvm_flags = {json.dumps(hosted_flags)}, '
        f"modules = {json.dumps(['//compiler:' + name for name in vm_access.values()])}, root_modules = {json.dumps(sorted(vm_access))}, "
        f'jar_property = "svm.test.CheckSVMInvariants.jars", property_jars = {json.dumps(checked)})\n'
        f'svm_test_runner(name = "svm_pointsto_junit", test_classpath = [":STANDALONE_POINTSTO_TESTS"], jvm_flags = {json.dumps(pointsto_flags)})\n'
        f'svm_test_runner(name = "svm_graal_junit", test_classpath = [":com.oracle.svm.graal.test"], jvm_flags = {json.dumps(["-XX:-UseJVMCICompiler", *concealed])})\n'
    )


def svm_native_unittests(directory):
    """In-image JUnit tests over SVM_TESTS, as `mx native-unittest` runs them."""
    graph = json.loads((directory / "mx-graph.json").read_text())
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    members = suite["distributions"]["SVM_TESTS"]["dependencies"]
    discovered = sorted(
        test
        for project in graph["projects"]
        if project["name"] in members
        for test in project.get("tests", [])
        if any(selector in test for selector in SVM_NATIVE_UNITTEST_SELECTORS)
        and test not in SVM_NATIVE_UNITTEST_IGNORED
    )
    return (
        'load("@rules_mx//graal:svm.bzl", "svm_native_unittest")\n'
        # The image build uses every core; cpu:4 keeps other tests from competing with it.
        # GitHub1398 needs a multicast-capable network interface, which BuildBuddy's remote
        # executors lack, so the test runs on the host even under the rbe profile.
        f'svm_native_unittest(name = "native_unittest", tests = {json.dumps(discovered)}, deps = [":SVM_TESTS"], default_group = True, tags = ["cpu:4", "no-remote-exec"])\n'
    )


def svm_platform_requires(directory):
    """Require the modules of platform-specific libraries per target platform.

    mx names the module of a platform-specific library, such as the LLVM backend's shadowed
    JavaCPP natives, for the host it runs on, and on some platforms the suite names none.
    The exporter leaves these libraries out of module descriptors (--platform-library). This
    adds the `requires` that mx would emit on each pinned platform as a select().
    """
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    modules = {}
    for name in SVM_URL_LIBRARIES:
        library = suite["libraries"].get(name, {})
        if "os_arch" not in library:
            continue
        modules[name] = {
            setting: config["moduleName"]
            for os_name, arch, setting in SVM_INPUT_PLATFORMS.values()
            if "moduleName"
            in (config := library["os_arch"].get(os_name, {}).get(arch, {}))
        }
    build = directory / "BUILD.bazel"
    blocks = re.split(r"(?m)^(?=\S)", build.read_text())
    for index, block in enumerate(blocks):
        used = [name for name in modules if f'        ":{name}",\n' in block]
        if not block.startswith("mx_jar_dist(") or not used:
            continue
        entries = []
        for _, _, setting in sorted(SVM_INPUT_PLATFORMS.values(), key=lambda v: v[2]):
            directives = sorted(
                f'            "requires {modules[name][setting]}",\n'
                for name in used
                if setting in modules[name]
            )
            entries.append(
                f'        ":{setting}": [\n' + "".join(directives) + "        ],\n"
                if directives
                else f'        ":{setting}": [],\n'
            )
        select = (
            "    platform_directives = select({\n"
            + "".join(entries)
            + '        "//conditions:default": [],\n'
            + "    }),\n"
        )
        head, marker, tail = block.partition("    directives = [\n")
        if not marker:
            raise ValueError("Expected module directives in " + block.splitlines()[1])
        listing, end, rest = tail.partition("    ],\n")
        blocks[index] = head + marker + listing + end + select + rest
    build.write_text("".join(blocks))


def svm_graalvm_support(directory):
    """The platform-specific SVM_GRAALVM_SUPPORT layout, for the platforms SVM_HOSTED_NATIVE supports."""
    name = "SVM_GRAALVM_SUPPORT"
    suite = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    if name not in suite["distributions"]:
        return ""
    pins = svm_url_inputs(directory)
    members = {}
    platform_members = {setting: {} for _, _, setting in SVM_INPUT_PLATFORMS.values()}
    imports = {}

    def destination_path(destination, filename):
        return destination + filename if destination.endswith("/") else destination

    for destination, sources in suite["distributions"][name]["layout"].items():
        for source in [sources] if isinstance(sources, str) else sources:
            kind, _, value = source.partition(":")
            if kind == "file":
                # mx copies a matching directory with its contents.
                matches = {}
                for path in directory.glob(value) if "*" in value else [Path(value)]:
                    if not path.is_absolute() or path.is_file():
                        matches[path] = path.name
                    else:
                        for file in path.rglob("*"):
                            if file.is_file():
                                matches[file] = (
                                    path.name + "/" + file.relative_to(path).as_posix()
                                )
                if not matches:
                    raise ValueError(f"{name}: no files match {value}")
                for path, relative in sorted(matches.items()):
                    source_path = (
                        path.relative_to(directory).as_posix()
                        if path.is_absolute()
                        else value
                    )
                    members.setdefault(source_path, []).append(
                        destination_path(destination, relative)
                    )
                continue
            qualified, _, member = value.partition("/")
            owner, colon, dep = qualified.partition(":")
            if not colon:
                owner, dep = "substratevm", owner
            if owner != "substratevm":
                raise ValueError(f"Unsupported {name} dependency {source}")
            library = suite["libraries"].get(dep)
            if kind == "extracted-dependency" and library and member:
                # A platform-specific archive; absent where mx marks it optional.
                for platform, (_, _, setting) in SVM_INPUT_PLATFORMS.items():
                    if (key := f"{dep.lower()}_{platform}") in pins:
                        platform_members[setting][f"@graal_svm_{key}//:{member}"] = [
                            destination_path(destination, Path(member).name)
                        ]
            elif kind == "extracted-dependency" and not member:
                imports.setdefault(":" + dep, []).append("=" + destination)
            elif kind == "dependency" and library and "maven" in library:
                maven = library["maven"]
                filename = f"{maven['artifactId']}-{maven['version']}.jar"
                members.setdefault(":" + dep, []).append(
                    destination_path(destination, filename)
                )
            elif kind == "dependency" and dep in suite["projects"]:
                members.setdefault(":" + dep, []).append(
                    destination_path(destination, "{basename}")
                )
            else:
                raise ValueError(f"Unsupported {name} layout {source}")
    joined = {label: "\n".join(paths) for label, paths in members.items()}
    selected = {
        ":" + setting: {label: "\n".join(paths) for label, paths in entries.items()}
        for setting, entries in platform_members.items()
    } | {"//conditions:default": {}}
    compatible = {":" + setting: [] for setting in platform_members} | {
        "//conditions:default": ["@platforms//:incompatible"]
    }
    return (
        "mx_archive_layout(\n"
        f'    name = "{name}",\n'
        '    format = "tar",\n'
        f"    members = {json.dumps(joined)} | select({json.dumps(selected)}),\n"
        f"    archive_imports = {json.dumps({k: chr(10).join(v) for k, v in imports.items()})},\n"
        f"    target_compatible_with = select({json.dumps(compatible)}),\n"
        '    visibility = ["//visibility:public"],\n'
        ")\n"
    )


def support_layout_rules(directory, names):
    suite = directory.name
    metadata = runpy.run_path(str(directory / f"mx.{suite}/suite.py"))["suite"]
    rules = ['load("@rules_mx//graal:layout.bzl", "mx_archive_layout")']
    for name in names:
        members = {}
        extracts = {}
        for destination, sources in metadata["distributions"][name]["layout"].items():
            is_directory = destination.endswith("/")
            destination = destination.removeprefix("./")
            if isinstance(sources, str):
                sources = [sources]
            for source in sources:
                kind, _, value = source.partition(":")
                if kind == "file":
                    path = (
                        destination + Path(value).name if is_directory else destination
                    )
                    members.setdefault(value, []).append(path)
                elif kind in ("dependency", "extracted-dependency"):
                    qualified, _, member = value.partition("/")
                    owner, colon, dist = qualified.partition(":")
                    label = f"//{owner}:{dist}" if colon else f":{qualified}"
                    if kind == "dependency" and not member and not is_directory:
                        members.setdefault(label, []).append(destination)
                    elif kind == "extracted-dependency" and is_directory:
                        path = (
                            destination + Path(member).name if member else destination
                        )
                        extracts.setdefault(label, []).append(member + "=" + path)
                    else:
                        raise ValueError(
                            f"Unsupported {directory.name} dependency layout {source}"
                        )
                else:
                    raise ValueError(f"Unsupported {directory.name} layout {source}")
        file_paths = {file: "\n".join(paths) for file, paths in members.items()}
        archive_paths = {
            archive: "\n".join(paths) for archive, paths in extracts.items()
        }
        rules.append(
            "mx_archive_layout(\n"
            f'    name = "{name}",\n'
            '    format = "tar",\n'
            f"    members = {json.dumps(file_paths)},\n"
            f"    archive_imports = {json.dumps(archive_paths)},\n"
            '    visibility = ["//visibility:public"],\n'
            ")"
        )
    return "\n".join(rules) + "\n"


def svm_support_layouts(directory):
    names = (
        "TRUFFLE_GRAALVM_SUPPORT",
        "TRUFFLE_SVM_GRAALVM_SUPPORT",
        "NATIVE_IMAGE_LICENSE_GRAALVM_SUPPORT",
        "NATIVE_IMAGE_JUNIT_SUPPORT",
        "SVM_LLVM_GRAALVM_SUPPORT",
        "SVM_NFI_GRAALVM_SUPPORT",
        "SVM_TRUFFLE_RUNTIME_GRAALVM_SUPPORT",
        "TRUFFLE_LANGUAGE_LIBRARY_COMMUNITY_GRAALVM_SUPPORT",
    )
    metadata = runpy.run_path(str(directory / "mx.substratevm/suite.py"))["suite"]
    version_name = "TRUFFLE_RUNTIME_SVM_VERSION"
    ((destination, source),) = metadata["distributions"][version_name]["layout"].items()
    if source != "dependency:sdk:VERSION/version":
        raise ValueError("Unsupported SubstrateVM Truffle runtime version layout")
    copies = {destination: "//sdk:VERSION.files/version"}
    targets = [
        ":" + name
        for name in (*names, *present(directory, SVM_SUPPORT_JARS), version_name)
    ]
    if "SVM_GRAALVM_SUPPORT" in metadata["distributions"]:
        targets.append(":SVM_GRAALVM_SUPPORT")
    tests = [":" + name for name in present(directory, SVM_TEST_JARS)]
    return support_layout_rules(directory, names) + (
        'load("@rules_mx//mx:graph.bzl", "mx_resource_layout")\n'
        f'mx_resource_layout(name = "{version_name}", copies = {json.dumps(copies)}, visibility = ["//visibility:public"]) # keep\n'
        f'filegroup(name = "support_distributions", srcs = {json.dumps(targets)}, visibility = ["//visibility:public"])\n'
        f'filegroup(name = "test_distributions", srcs = {json.dumps(tests)}, testonly = True, visibility = ["//visibility:public"])\n'
    )


def binding_providers(suite, source):
    """Find known providers in mx import order, including transitive suite imports."""
    found = []

    def visit(name):
        metadata = runpy.run_path(str(source / name / f"mx.{name}/suite.py"))["suite"]
        for dep in metadata.get("imports", {}).get("suites", []):
            owner = dep["name"]
            if (
                not dep.get("dynamic")
                and owner in (*SUITES, *PARTIAL_SUITES)
                and owner not in found
            ):
                visit(owner)
                found.append(owner)

    visit(suite)
    return found


def stage_external_suites(source, stage, suites):
    """Stage only the pinned discovery metadata for external imports of selected suites."""
    imports = {}
    for suite in suites:
        metadata = runpy.run_path(str(source / suite / f"mx.{suite}/suite.py"))["suite"]
        for dep in metadata.get("imports", {}).get("suites", []):
            if (
                dep.get("version")
                and dep.get("urls")
                and not (source / dep["name"]).is_dir()
                and not dep.get("dynamic")
            ):
                previous = imports.setdefault(dep["name"], dep)
                if previous["version"] != dep["version"]:
                    raise ValueError(
                        f"Conflicting versions for external suite {dep['name']}"
                    )
    if not imports:
        return
    manifest = bazel_source("@graal_suite_metadata//:imports.json")
    pins = json.loads(manifest.read_text())
    for name, dep in imports.items():
        pin = pins.get(name, {})
        if pin.get("revision") != dep["version"] or pin.get("repository") not in [
            item["url"] for item in dep["urls"]
        ]:
            raise ValueError(
                f"Pin discovery metadata for {name} at {dep['version']} in graal/suite_imports.json"
            )
        checkout = stage.parent / pin["repository"].rsplit("/", 1)[-1].removesuffix(
            ".git"
        )
        for path in pin["files"]:
            dest = checkout / path
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(manifest.parent / name / path, dest)
        (checkout / ".mx_vcs_root").touch()


def prepare_suite(suite, stage):
    directory = stage / suite
    if suite == "vm":
        (directory / "BUILD.bazel").write_text(
            support_layout_rules(directory, ("VM_GRAALVM_SUPPORT",))
        )
        return
    if suite in PARTIAL_SUITES:
        export_options = [
            "--all",
            "--declared-only",
            "--partial",
            *(
                arg
                for owner in binding_providers(suite, stage)
                for arg in (
                    "--bindings",
                    f"//{owner}={stage / (owner + '-bindings.json')}",
                )
            ),
            "--java-dep",
            "mx:JUNIT=@contrib_rules_jvm_deps//:junit_junit",
            "--java-dep",
            "mx:JUNIT=@contrib_rules_jvm_deps//:org_hamcrest_hamcrest_core",
            "--java-dep",
            "mx:HAMCREST=@contrib_rules_jvm_deps//:org_hamcrest_hamcrest_core",
            *(
                ["--javac-only-processor", "truffle:TRUFFLE_DSL_PROCESSOR"]
                if suite in ("sulong", "wasm", "espresso")
                else []
            ),
        ]
    else:
        export_options = suite_args(directory)
    if suite == "espresso":
        export_options.extend(
            [
                "--whole-project",
                "com.oracle.truffle.espresso.libjavavm",
                "--project-release",
                "com.oracle.truffle.espresso=25",
                "--patch-module-runtime",
                "21=@rules_mx//tools:espresso_jdk21_runtime",
                "--patch-module-runtime",
                "25=@rules_mx//tools:labs_runtime",
            ]
        )
    if suite == "web-image":
        export_options.extend(
            [
                "--javac-opt",
                "com.oracle.svm.hosted.webimage=-Xep:DoubleBraceInitialization:WARN",
                # These fixtures compile pathological JVM bytecodes on purpose.
                "--javac-opt",
                "com.oracle.svm.webimage.jtt=-XepDisableAllChecks",
                "--generated-dep",
                "web-image:com.oracle.svm.hosted.webimage.test=:NET_JAVA_HTML_JSON_TCK",
                "--test-launcher",
                "web-image:com.oracle.svm.hosted.webimage.test=:webimage_junit",
            ]
        )
    if suite == "sulong":
        export_options.extend(
            [
                "--whole-project",
                "com.oracle.truffle.llvm.toolchain.launchers",
                "--sulong-llvm-link",
                "@rules_mx//graal:sdk_llvm_link",
                "--sulong-fixture-sdk",
                "@rules_mx//graal:sulong_fixture_sdk",
            ]
        )
    if suite == "wasm":
        export_options.extend(mx_library_rules(directory, ["JMH_1_21"])[1])
        export_options.extend(["--processor-plugin", "mx:JMH_1_21=:jmh_processor"])
        for project in ("testcases", "benchcases"):
            export_options += [
                "--java-dep",
                f"wasm:org.graalvm.wasm.{project}=:{project}_resources",
            ]
        export_options += [
            "--library-module",
            "mx:JUNIT=junit",
            "--library-module",
            "mx:HAMCREST=hamcrest",
        ]
        for i, arg in enumerate(export_options):
            if arg.startswith("mx:JUNIT=") and "junit_junit" in arg:
                export_options[i] = "mx:JUNIT=@rules_mx//graal:junit"
            elif (
                arg.startswith(("mx:JUNIT=", "mx:HAMCREST=")) and "hamcrest_core" in arg
            ):
                export_options[i] = arg.split("=")[0] + "=@rules_mx//graal:hamcrest"
        wat2wasm = "@wabt//src/tools:wat2wasm"
        export_options.extend(
            [
                "--wat2wasm",
                wat2wasm,
                "--wasm2wat",
                "@wabt//src/tools:wasm2wat",
                "--test-runtime",
                "wasm:org.graalvm.wasm.testcases.test=:org.graalvm.wasm.testcases.test",
                "--test-runtime",
                "wasm:org.graalvm.wasm.testcases.test=:testcases_resources",
                "--test-runtime",
                "wasm:org.graalvm.wasm.testcases.test=//truffle:TRUFFLE_RUNTIME",
                "--test-data",
                f"wasm:org.graalvm.wasm.testcases.test={wat2wasm}",
                "--test-jvm-flag",
                f"wasm:org.graalvm.wasm.testcases.test=-Dwasmtest.watToWasmExecutable=$(rootpath {wat2wasm})",
                "--test-jvm-flag",
                "wasm:org.graalvm.wasm.testcases.test=-Dpolyglot.engine.AllowExperimentalOptions=true",
                "--test-jvm-flag",
                "wasm:org.graalvm.wasm.testcases.test=--enable-native-access=ALL-UNNAMED",
            ]
        )
        project = "wasm:org.graalvm.wasm.test"
        export_options.extend(
            [
                "--test-data",
                f"{project}={wat2wasm}",
                "--test-runtime",
                f"{project}=:org.graalvm.wasm.test",
                "--test-runtime",
                f"{project}=//truffle:TRUFFLE_RUNTIME",
                *(
                    arg
                    for flag in (
                        f"-Dwasmtest.watToWasmExecutable=$(rootpath {wat2wasm})",
                        "-Dpolyglot.engine.AllowExperimentalOptions=true",
                        "-Dpolyglot.engine.WarnInterpreterOnly=false",
                        "--enable-native-access=ALL-UNNAMED",
                    )
                    for arg in ("--test-jvm-flag", f"{project}={flag}")
                ),
            ]
        )
    if suite != "vm":
        export_options = [
            *export_options,
            "--bindings-out",
            str(stage / f"{suite}-bindings.json"),
        ]
    if suite == "truffle":
        metadata = runpy.run_path(str(directory / "mx.truffle/suite.py"))["suite"]
        export_options = [
            *export_options,
            *(
                arg
                for name in truffle_layout_distributions(metadata)
                for arg in ("--provided-target", name)
            ),
        ]
    with (directory / "mx-graph.json").open("w") as graph:
        subprocess.run(
            [
                "bazelisk",
                "run",
                "--config=labsjdk",
                "//:mx",
                "--",
                "-p",
                str(directory),
                "bazel-buildfile",
                "--gazelle",
                "--classpath-dists",
                "--release",
                "21",
                *shading_inputs(directory)[1],
                *harness_options(directory),
                *export_options,
            ],
            cwd=ROOT,
            check=True,
            stdout=graph,
            env={
                **os.environ,
                "MX_CACHE_DIR": str(stage / ".mx-cache"),
                # mx otherwise bakes the discovery host's debug default into the image
                # flags. rules_graalvm applies the Bazel compilation mode at analysis.
                "GENERATE_DEBUGINFO": "false",
                "DEBUG_IMAGES": "false",
            },
        )
    if (stage / ".mx-cache").exists() and any(
        p.is_file() for p in (stage / ".mx-cache").rglob("*")
    ):
        raise RuntimeError(
            "Graph discovery unexpectedly populated the mx artifact cache"
        )
    # An implicit Bazel test_suite includes the generated JUnit targets in
    # this package, so new test classes join the CI qualification on regeneration.
    if suite in PARTIAL_SUITES:
        graph = json.loads((directory / "mx-graph.json").read_text())
        inventory = graph["suite_targets"]
        rules = [library_rules(directory)] if suite in JAVA_LIBRARIES else []
        if suite == "web-image":
            rules.extend(mx_library_rules(directory, ["JUNIT-JUPITER-API"])[2])
            metadata = runpy.run_path(str(directory / "mx.web-image/suite.py"))["suite"]
            flags = sorted(
                {
                    f"--add-exports={module}/{package}=ALL-UNNAMED"
                    for project in metadata["projects"].values()
                    for module, packages in project.get("requiresConcealed", {}).items()
                    if module.startswith("java.")
                    for package in packages
                }
            )
            vm_access, exports = vm_access_modules(directory)
            rules.extend(
                [
                    'load("@rules_mx//graal:simplelanguage.bzl", "svm_test_runner")',
                    f'svm_test_runner(name = "webimage_junit", test_classpath = [":WEBIMAGE_TESTS"], jvm_flags = {json.dumps(flags + exports)}, modules = {json.dumps(["//compiler:" + name for name in vm_access.values()])}, root_modules = {json.dumps(sorted(vm_access))})',
                ]
            )
            units = sorted(
                ":" + project["name"] + "." + cls
                for project in graph["projects"]
                for cls in project.get("tests", [])
                if ".test.unit." in cls
            )
            rules.append(
                f'test_suite(name = "unit_tests", tests = {json.dumps(units)}, visibility = ["//visibility:public"])'
            )
        linux_projects = {p["name"] for p in graph.get("cmake_suites", [])}
        for kind, names in inventory.items():
            platform_targets = [
                ":" + n for n in names if kind == "projects" and n in linux_projects
            ]
            srcs = json.dumps(
                [":" + n for n in names if ":" + n not in platform_targets]
            )
            if platform_targets:
                srcs += (
                    ' + select({"@rules_mx//tools:exec_linux_amd64": '
                    + json.dumps(platform_targets)
                    + ', "//conditions:default": []})'
                )
            rules.append(
                f'filegroup(name = "all_{kind}", srcs = {srcs}, testonly = True, visibility = ["//visibility:public"])'
            )
        for fixture in graph.get("cmake_suites", []):
            if fixture["name"] == "com.oracle.truffle.llvm.tests.sulong.Os.native":
                rules += [
                    'load("@rules_mx//graal:sulong_fixture_check.bzl", "sulong_fixture_check")',
                    'sulong_fixture_check(name = "fixture_test", project = %s, root = %s, modules = %s, sdk = %s)'
                    % tuple(
                        json.dumps(fixture[k])
                        for k in ("name", "root", "modules", "sdk")
                    ),
                ]
        if suite == "wasm":
            rules += [
                "# gazelle:resolve java org.openjdk.jol.info //wasm:JOL",
                jmh_rules(directory)[1],
                *(
                    f'java_import(name="{project}_resources", jars=[":org.graalvm.wasm.{project}.resources"], testonly=True)'
                    for project in ("testcases", "benchcases")
                ),
            ]
            tests = {
                cls: ":" + project["name"] + "." + cls
                for project in graph["projects"]
                for cls in project.get("tests", [])
            }
            qualified = sorted(
                target for cls, target in tests.items() if cls not in WASM_OPEN_TESTS
            )
            rules.append(
                f'test_suite(name = "qualified_tests", tests = {json.dumps(qualified)}, visibility = ["//visibility:public"])'
            )
        (directory / "BUILD.bazel").write_text("\n".join(rules) + "\n")
        print(
            f"{suite}: {len(inventory['projects'])} projects, {len(inventory['distributions'])} distributions exported",
            file=sys.stderr,
        )
        for reason, names in sorted(graph["blocked_roots"].items()):
            print(f"  {reason}: {', '.join(names)}", file=sys.stderr)
    elif suite == "sdk":
        (directory / "BUILD.bazel").write_text(
            sdk_native_projects(directory)
            + sdk_llvm_rules(directory)
            + sdk_descriptor_rules(directory)
            + 'test_suite(name = "tests", visibility = ["//visibility:public"])\n'
        )
    elif suite == "compiler":
        (directory / "BUILD.bazel").write_text(
            library_rules(directory)
            + jmh_rules(directory)[1]
            + compiler_harness(directory)
            + qualified_tests(directory)
            + 'load("@rules_mx//graal:simplelanguage.bzl", "simplelanguage")\n'
            'simplelanguage(name = "sl_jit", compiler = ":GRAAL")\n\n'
            'simplelanguage(name = "sl_compilation_test", compiler = ":GRAAL", probe = "@rules_mx//graal:compiled_guest")\n'
        )
    elif suite == "truffle":
        (directory / "BUILD.bazel").write_text(
            "".join(
                f"# gazelle:resolve java {pkg} {label}\n"
                for pkg, label in {
                    "com.oracle.truffle.api.impl": "//truffle:com.oracle.truffle.api",
                    "com.oracle.truffle.api.impl.asm": "//truffle:com.oracle.truffle.api.impl.asm",
                    "org.graalvm.collections": "//sdk:COLLECTIONS",
                    "org.graalvm.nativeimage": "//sdk:NATIVEIMAGE",
                    "org.graalvm.polyglot": "//sdk:POLYGLOT",
                }.items()
            )
            + "\n"
            + library_rules(directory)
            + qualified_tests(directory)
            + jmh_rules(directory)[1]
            + truffle_native_projects(directory)
        )
    elif suite == "espresso-shared":
        (directory / "BUILD.bazel").write_text(espresso_shared_rules(directory))
    elif suite in ("regex", "tools"):
        targets = json.loads((directory / "mx-graph.json").read_text())["suite_targets"]
        layouts = []
        if suite == "tools":
            layouts.extend(
                [
                    'load("@rules_mx//graal:visualvm.bzl", "visualvm_support")',
                    'visualvm_support(name = "VISUALVM_GRAALVM_SUPPORT")',
                ]
            )
        inventories = [
            f'filegroup(name = "all_{kind}", srcs = {json.dumps([":" + name for name in targets[kind]])}, testonly = True, visibility = ["//visibility:public"])'
            for kind in ("projects", "distributions")
        ]
        (directory / "BUILD.bazel").write_text(
            'load("@rules_java//java:java_import.bzl", "java_import")\n'
            + (jmh_rules(directory)[1] if suite == "regex" else "")
            + "\n".join(layouts + inventories)
            + "\n"
        )
    elif suite == "substratevm":
        (directory / "BUILD.bazel").write_text(
            library_rules(directory)
            + svm_url_library_rules(directory)[0]
            + 'load("@rules_mx//graal:svm.bzl", "svm_compiler_flags")\n'
            'svm_compiler_flags(name = "svm-compiler-flags-builder", builder = ":SVM", '
            'linux = select({"@platforms//os:linux": True, "//conditions:default": False}))\n'
            'load("@rules_mx//graal:simplelanguage.bzl", "svm_driver_test_runner")\n'
            'svm_driver_test_runner(name = "svm_driver_junit")\n'
            + svm_support_layouts(directory)
            + svm_native_rules(directory)
            + svm_native_unittests(directory)
            + svm_test_runners(directory)
        )


def generate_build_files(suites, stage):
    suites = [suite for suite in suites if suite != "vm"]
    if not suites:
        return
    subprocess.run(
        [
            "bazelisk",
            "run",
            "//:gazelle",
            "--",
            "-repo_root=" + str(stage),
            *(f"-mx_graph={suite}/mx-graph.json" for suite in suites),
            *(str(stage / suite) for suite in suites),
        ],
        cwd=ROOT,
        check=True,
    )


def build_patch(directory, stage):
    patch = []
    for build in sorted(directory.rglob("BUILD.bazel")):
        path = build.relative_to(stage).as_posix()
        patch.append(f"diff --git a/{path} b/{path}\nnew file mode 100644\n")
        patch.extend(
            difflib.unified_diff(
                [],
                build.read_text().splitlines(True),
                fromfile="/dev/null",
                tofile="b/" + path,
            )
        )
    return "".join(patch)


def bazel_source(label):
    location = subprocess.check_output(
        ["bazelisk", "query", "--output=location", label], cwd=ROOT, text=True
    )
    return Path(location.split(": source file ", 1)[0].rsplit(":", 2)[0])


def emit(path, text, check, message):
    if check:
        if not path.exists():
            sys.exit(message)
        current = path.read_text()
        if current != text:
            sys.stderr.writelines(difflib.unified_diff(
                current.splitlines(True), text.splitlines(True),
                fromfile=str(path), tofile=str(path) + " (regenerated)", n=2,
            ))
            sys.exit(message)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)


def fetch_source(pin, stage):
    """Download and verify a source archive described like //graal:source.json."""
    archive = stage / "source.tar.gz"
    request = urllib.request.Request(
        pin["urls"][0], headers={"User-Agent": "rules_mx-generate-graal"}
    )
    digest = hashlib.sha256()
    with urllib.request.urlopen(request) as response, archive.open("wb") as out:
        while chunk := response.read(1 << 20):
            digest.update(chunk)
            out.write(chunk)
    if pin.get("sha256") and digest.hexdigest() != pin["sha256"]:
        sys.exit(
            f"{pin['urls'][0]} has SHA-256 {digest.hexdigest()}, expected {pin['sha256']}"
        )
    root = stage / "source"
    with tarfile.open(archive) as tar:
        tar.extractall(root, filter="data")
    archive.unlink()
    return root / pin["strip_prefix"], digest.hexdigest()


def labsjdk_pin(source, current, selector, repository):
    """Pin labsjdk-ce-latest from the selected source's common.json."""
    version = json.loads((source / "common.json").read_text())["jdks"][selector][
        "version"
    ]
    if current.get("version") == version:
        return current
    jdk, jvmci = version.split("-jvmci-")
    request = urllib.request.Request(
        f"https://api.github.com/repos/graalvm/{repository}/releases/tags/jvmci-{jvmci}",
        headers={"User-Agent": "rules_mx-generate-graal"},
    )
    with urllib.request.urlopen(request) as response:
        assets = {a["name"]: a for a in json.load(response)["assets"]}
    platforms = {}
    for platform in current["platforms"]:
        asset = assets[f"labsjdk-{version}-{platform}.tar.gz"]
        if not asset.get("digest"):
            url = asset["browser_download_url"]
            with urllib.request.urlopen(url + ".sha1") as response:
                expected = response.read().decode().split()[0]
            sha1, sha256 = hashlib.sha1(), hashlib.sha256()
            with urllib.request.urlopen(url) as response:
                while chunk := response.read(1024 * 1024):
                    sha1.update(chunk)
                    sha256.update(chunk)
            if sha1.hexdigest() != expected:
                raise ValueError(f"Checksum mismatch for {asset['name']}")
            platforms[platform] = sha256.hexdigest()
            continue
        algorithm, digest = asset["digest"].split(":")
        if algorithm != "sha256":
            raise ValueError(f"Unexpected digest for {asset['name']}")
        platforms[platform] = digest
    return {"platforms": platforms, "version": version}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "graal",
        nargs="?",
        type=Path,
        help="Graal checkout (defaults to the archive in graal/source.json)",
    )
    parser.add_argument(
        "--check", action="store_true", help="compare with the checked-in overlay"
    )
    parser.add_argument(
        "--suite",
        action="append",
        choices=[*SUITES, *PARTIAL_SUITES, "vm"],
        help="only regenerate the named BUILD overlays",
    )
    parser.add_argument("--archive", help="Graal source archive URL to generate for")
    parser.add_argument("--sha256", help="expected SHA-256 of --archive")
    parser.add_argument(
        "--strip-prefix", help="directory prefix of the --archive members"
    )
    parser.add_argument(
        "--pin",
        action="store_true",
        help="record --archive in graal/source.json as the default source",
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=ROOT / "graal",
        help="directory for the overlay patches and input pins (default: graal/)",
    )
    args = parser.parse_args()
    if args.archive and args.graal:
        parser.error("Pass either a checkout or --archive")
    if args.pin and not args.archive:
        parser.error("--pin requires --archive")
    if args.archive and args.strip_prefix is None:
        parser.error("--archive requires --strip-prefix")
    output = args.output.resolve()
    # Keep a downloaded tree outside the stage so mx sees one copy of each suite.
    with (
        tempfile.TemporaryDirectory() as temp,
        tempfile.TemporaryDirectory() as fetched,
    ):
        stage = Path(temp).resolve() / "graal"
        stage.mkdir()
        source = args.graal.resolve() if args.graal else None
        if source is None:
            pin_path = ROOT / "graal/source.json"
            pin = json.loads(pin_path.read_text())
            if args.archive:
                pin = {
                    "sha256": args.sha256,
                    "strip_prefix": args.strip_prefix,
                    "urls": [args.archive],
                }
            source, digest = fetch_source(pin, Path(fetched))
            if args.pin:
                pin["sha256"] = digest
                pin_path.write_text(json.dumps(pin, indent=2, sort_keys=True) + "\n")
        for filename, selector, repository in (
            ("labsjdk.json", "labsjdk-ce-latest", "labs-openjdk"),
            ("labsjdk21.json", "labsjdk-ce-21", "labs-openjdk-21"),
        ):
            labsjdk = ROOT / "mx" / filename
            current = json.loads(labsjdk.read_text())
            emit(
                labsjdk if output == ROOT / "graal" else output / filename,
                json.dumps(
                    labsjdk_pin(source, current, selector, repository),
                    indent=2,
                    sort_keys=True,
                )
                + "\n",
                args.check,
                "Regenerate the Labs JDK pin with tools/generate-graal",
            )
        mx_suite = bazel_source("@graal_mx//:mx.mx/suite.py")
        shutil.copyfile(mx_suite, stage / "mx-suite.py")
        for family in ("gcc", "msvc"):
            name = family + ".ninja_template"
            shutil.copyfile(
                mx_suite.parents[1] / "ninja-toolchains" / name, stage / name
            )
        (stage / ".mx_vcs_root").touch()
        (stage / "WORKSPACE").touch()
        (stage / "BUILD.bazel").write_text(
            "# gazelle:map_kind java_library elide_java_library @rules_mx//mx:java.bzl\n"
        )
        selected = list(dict.fromkeys(args.suite or [*SUITES, *PARTIAL_SUITES, "vm"]))
        providers = list(
            dict.fromkeys(
                owner
                for suite in selected
                if suite in PARTIAL_SUITES
                for owner in binding_providers(suite, source)
            )
        )
        stage_external_suites(source, stage, [*selected, *providers])
        for suite in PARTIAL_SUITES:
            if suite in selected or suite in providers:
                shutil.copytree(
                    source / suite,
                    stage / suite,
                    ignore=shutil.ignore_patterns(
                        "BUILD", "BUILD.bazel", "mxbuild", "__pycache__"
                    ),
                )
            else:
                shutil.copytree(
                    source / suite / f"mx.{suite}", stage / suite / f"mx.{suite}"
                )
        for suite in SUITES:
            for directory in (f"mx.{suite}", "src"):
                rel = Path(suite) / directory
                shutil.copytree(
                    source / rel,
                    stage / rel,
                    ignore=shutil.ignore_patterns(
                        "BUILD", "BUILD.bazel", "__pycache__"
                    ),
                )
        shutil.copytree(source / "vm/mx.vm", stage / "vm/mx.vm")
        shutil.copytree(
            source / "truffle/benchmarks",
            stage / "truffle/benchmarks",
            ignore=shutil.ignore_patterns("BUILD", "BUILD.bazel"),
        )
        shutil.copytree(
            source / "substratevm/debug/include", stage / "substratevm/debug/include"
        )
        # SVM_GRAALVM_SUPPORT packages every file that matches skills/*.
        if (source / "substratevm/skills").is_dir():
            shutil.copytree(source / "substratevm/skills", stage / "substratevm/skills")
        lib = runpy.run_path(str(stage / "truffle/mx.truffle/suite.py"))["suite"][
            "libraries"
        ]["LIBFFI_SOURCES"]
        algorithm, digest = lib["digest"].split(":")
        libffi = output / "libffi.json"
        pin = (
            json.dumps(
                dict(
                    version=lib["version"],
                    urls=[u.format(**lib) for u in lib["urls"]],
                    integrity=algorithm
                    + "-"
                    + base64.b64encode(bytes.fromhex(digest)).decode(),
                ),
                indent=2,
            )
            + "\n"
        )
        emit(
            libffi,
            pin,
            args.check,
            "Regenerate the libffi pin with tools/generate-graal",
        )
        hsdis = output / "hsdis.json"
        pins = (
            json.dumps(hsdis_inputs(stage / "compiler"), indent=2, sort_keys=True)
            + "\n"
        )
        emit(
            hsdis,
            pins,
            args.check,
            "Regenerate the HSDIS pins with tools/generate-graal",
        )
        sdk_llvm = output / "sdk_llvm.json"
        sdk_llvm_pins = (
            json.dumps(sdk_llvm_inputs(stage / "sdk"), indent=2, sort_keys=True) + "\n"
        )
        emit(
            sdk_llvm,
            sdk_llvm_pins,
            args.check,
            "Regenerate the SDK LLVM pins with tools/generate-graal",
        )
        sdk_musl = output / "sdk_musl.json"
        sdk_musl_pins = (
            json.dumps(sdk_musl_inputs(stage / "sdk"), indent=2, sort_keys=True) + "\n"
        )
        emit(
            sdk_musl,
            sdk_musl_pins,
            args.check,
            "Regenerate the SDK musl pins with tools/generate-graal",
        )
        visualvm = output / "visualvm.json"
        visualvm_pins = (
            json.dumps(visualvm_inputs(stage / "tools"), indent=2, sort_keys=True)
            + "\n"
        )
        emit(
            visualvm,
            visualvm_pins,
            args.check,
            "Regenerate the VisualVM pins with tools/generate-graal",
        )
        svm_inputs = output / "svm_inputs.json"
        emit(
            svm_inputs,
            json.dumps(svm_url_inputs(stage / "substratevm"), indent=2, sort_keys=True)
            + "\n",
            args.check,
            "Regenerate the SubstrateVM input pins with tools/generate-graal",
        )
        lock = output / "shaded_inputs.json"
        lock_text = (
            json.dumps(
                {
                    k: v
                    for suite in (*SUITES, *PARTIAL_SUITES)
                    for k, v in shading_inputs(stage / suite)[0].items()
                },
                indent=2,
                sort_keys=True,
            )
            + "\n"
        )
        emit(
            lock,
            lock_text,
            args.check,
            "Shaded dependency pins differ. Regenerate with tools/generate-graal.",
        )
        for suite in dict.fromkeys([*providers, *selected]):
            prepare_suite(suite, stage)
        generate_build_files(selected, stage)
        if "substratevm" in selected:
            svm_platform_requires(stage / "substratevm")
        for suite in selected:
            emit(
                output / f"{suite}.patch",
                build_patch(stage / suite, stage),
                args.check,
                f"{suite} overlay differs. Regenerate it with tools/generate-graal.",
            )


if __name__ == "__main__":
    main()
