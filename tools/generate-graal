            'mx_archive_layout(name = "HSDIS_GRAALVM_SUPPORT", format = "tar", members = {":hsdis_library_file": "{basename}"}, visibility = ["//visibility:public"])',
            f'filegroup(name = "all_distributions", srcs = {json.dumps(distributions)}, testonly = True, visibility = ["//visibility:public"])',
        ]
