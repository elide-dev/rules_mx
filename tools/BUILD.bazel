load("@rules_elide//elide/java:toolchain.bzl", "elide_java_toolchain")
load("@rules_elide//elide/python:toolchain.bzl", "register_elide_python_toolchain")
load("@rules_java//toolchains:default_java_toolchain.bzl", "default_java_toolchain")

register_elide_python_toolchain(
    name = "linux_amd64",
    elide = "@elide_linux_amd64//:bin/elide",
    runtime_files = "@elide_linux_amd64//:elide_python_files",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

register_elide_python_toolchain(
    name = "linux_arm64",
    elide = "@elide_linux_arm64//:bin/elide",
    runtime_files = "@elide_linux_arm64//:elide_python_files",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

register_elide_python_toolchain(
    name = "macos_arm64",
    elide = "@elide_macos_arm64//:bin/elide",
    runtime_files = "@elide_macos_arm64//:elide_python_files",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "network": "off",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:f7db0d4791247f032fdb4451b7c3ba90e567923a341cc6dc43abfc283436791a",
    },
    visibility = ["//visibility:public"],
)

[config_setting(
    name = "exec_" + platform,
    constraint_values = constraints,
) for platform, constraints in {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "macos_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
}.items()]

elide_java_toolchain(
    name = "processor_java",
    elide = select({
        ":exec_linux_amd64": "@elide_linux_amd64//:elide",
        ":exec_linux_arm64": "@elide_linux_arm64//:elide",
        ":exec_macos_arm64": "@elide_macos_arm64//:elide",
    }),
    log_routes = True,
    misc = [
        "-XDskipDuplicateBridges=true",
        "-g",
        "-parameters",
    ],
)

# JVMCI packages are internal to the Labs JDK and absent from ct.sym.
default_java_toolchain(
    name = "labs_jvmci",
    bootclasspath = [],
    forcibly_disable_header_compilation = True,
    java_runtime = ":labs_runtime",
    toolchain_definition = False,
    visibility = ["//visibility:public"],
)

alias(
    name = "labs_runtime",
    actual = select({
        ":exec_linux_amd64": "@labsjdk_linux_amd64//:jdk",
        ":exec_linux_arm64": "@labsjdk_linux_aarch64//:jdk",
        ":exec_macos_arm64": "@labsjdk_darwin_aarch64//:jdk",
    }),
    visibility = ["//visibility:public"],
)
