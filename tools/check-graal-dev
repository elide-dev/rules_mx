#!/usr/bin/env python3
"""Qualify live Truffle edits, guest-language test selection and Bazel caching."""

import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
ARCHIVES = {
    "graal": "source.json",
    "graaljs": "graaljs_source.json",
    "graalpython": "graalpython_source.json",
}
TRUFFLE_SOURCE = (
    "truffle/src/com.oracle.truffle.api/src/com/oracle/truffle/api/Truffle.java"
)
TRUFFLE_LABEL = "@graal//" + TRUFFLE_SOURCE.replace("/Truffle.java", ":Truffle.java")
FIBONACCI = "@graal//truffle:sl.test.Fibonacci"
REGRESSIONS = {
    "@graal//graal-js:regression/direct_eval",
    "@graal//graal-js:regression/indirect_eval",
    "@graal//graalpython:zlib/ChecksumTestCase.test_crc32start",
    "@graal//graalpython:zlib/ChecksumTestCase.test_adler32start",
    FIBONACCI,
}
JS_MARKER = """
const Truffle = Java.type("com.oracle.truffle.api.Truffle");
print(typeof Truffle.rulesMxLiveMarker === "function" ? Truffle.rulesMxLiveMarker() : "before");
"""
PY_MARKER = """
import java
Truffle = java.type("com.oracle.truffle.api.Truffle")
marker = getattr(Truffle, "rulesMxLiveMarker", None)
print(marker() if marker else "before")
"""
LAUNCHERS = {
    "@graal//graal-js:js": ("-e", JS_MARKER),
    "@graal//graalpython:python": ("-c", PY_MARKER),
}


def main(config):
    fetch_source = runpy.run_path(str(ROOT / "tools/generate-graal"))["fetch_source"]
    with tempfile.TemporaryDirectory() as temp:
        workspace = Path(temp)
        for name, manifest in ARCHIVES.items():
            download = workspace / ("download-" + name)
            download.mkdir()
            spec = json.loads((ROOT / "graal" / manifest).read_text())
            source, _ = fetch_source(spec, download)
            source.rename(workspace / name)

        dev = [
            ROOT / "tools/graal-dev",
            "--workspace",
            workspace,
            "--state-dir",
            workspace / "overlays",
        ]
        if "--config=buildbuddy-rbe" in config:
            dev.append("--buildbuddy")
        options = ["--config=elide-processors", "--config=labsjdk", *config]

        def invoke(command, *args, **kwargs):
            return subprocess.run(
                [*dev, command, *options, *args], cwd=ROOT, check=True, **kwargs
            )

        def read_marker(launcher, marker):
            try:
                result = invoke(
                    "run",
                    f"--run_env=XDG_CACHE_HOME={workspace}",
                    f"--run_env=JAVA_TOOL_OPTIONS=-Duser.home={workspace}",
                    launcher,
                    "--",
                    "--engine.WarnInterpreterOnly=false",
                    *marker,
                    capture_output=True,
                    text=True,
                )
            except subprocess.CalledProcessError as error:
                sys.stderr.write(error.stderr)
                sys.stderr.write(error.stdout)
                raise
            return result.stdout.strip()

        affected = subprocess.check_output(
            [
                *dev,
                "query",
                f'kind(".*_test rule", rdeps(@graal//graal-js:all + filter(":zlib/", @graal//graalpython:all) + {FIBONACCI}, {TRUFFLE_LABEL}))',
            ],
            cwd=ROOT,
            text=True,
        ).splitlines()
        if set(affected) != REGRESSIONS:
            raise SystemExit(
                f"Unexpected test selection for the Truffle source edit {affected!r}"
            )
        configured = sorted((workspace / "overlays").glob("*.current"))
        if len(configured) != 1:
            raise SystemExit(f"Expected one live overlay. Found {configured!r}")
        for launcher, marker in LAUNCHERS.items():
            baseline = read_marker(launcher, marker)
            if baseline != "before":
                raise SystemExit(f"Unexpected baseline output from {launcher}: {baseline!r}")
        invoke("test", "--test_output=errors", *affected)
        truffle = workspace / "graal" / TRUFFLE_SOURCE
        source = truffle.read_text()
        anchor = "public final class Truffle {"
        if source.count(anchor) != 1:
            raise SystemExit(
                "The Truffle API moved. Update the live checkout edit probe."
            )
        truffle.write_text(
            source.replace(
                anchor,
                anchor
                + """
    public static String rulesMxLiveMarker() {
        return "after";
    }
""",
            )
        )
        for launcher, marker in LAUNCHERS.items():
            changed = read_marker(launcher, marker)
            if changed != "after":
                raise SystemExit(
                    f"{launcher} did not see the Truffle edit. Output was {changed!r}"
                )
        if sorted((workspace / "overlays").glob("*.current")) != configured:
            raise SystemExit("Editing an existing Truffle source regenerated the graph")
        invoke("test", "--test_output=errors", *affected)
        events = workspace / "cached.json"
        invoke(
            "test",
            "--test_output=errors",
            f"--build_event_json_file={events}",
            *affected,
        )
        results = [
            event["testResult"]
            for line in events.read_text().splitlines()
            if "testResult" in (event := json.loads(line))
        ]
        if len(results) != len(affected) or any(
            not (
                result.get("cachedLocally")
                or result.get("executionInfo", {}).get("cachedRemotely")
            )
            for result in results
        ):
            raise SystemExit(
                f"Expected cached results for the selected tests. Events {results!r}"
            )
        print("The Truffle edit reached GraalJS and GraalPy, and all selected tests were cached on repeat.")
        invoke("test", "--test_output=errors", "@graal//graalpython:jvm_standalone_test")


if __name__ == "__main__":
    main(sys.argv[1:])
