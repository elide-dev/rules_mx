#!/usr/bin/env bash
set -euo pipefail
# Run from the repository root, optionally with --config=buildbuddy-rbe.
bazel=bazelisk
if [[ ${1:-} == --config=buildbuddy-rbe ]]; then bazel=tools/buildbuddy; fi
snapshot=$(mktemp)
trap 'rm -f "$snapshot"' EXIT
"$bazel" run "$@" //:mx -- -p "$PWD/tests/gazelle" bazel-buildfile --gazelle \
  --java-dep mx:JUNIT=@contrib_rules_jvm_deps//:junit_junit check > "$snapshot"
diff -u tests/gazelle/mx-graph.json "$snapshot"
"$bazel" run "$@" //:gazelle -- -mx_graph=tests/gazelle/mx-graph.json -mode=diff tests/gazelle
