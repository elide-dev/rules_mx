exports_files([
    "toolchain.BUILD",
    "cc.sh.tpl",
])

[toolchain(
    name = "elide_cc_" + bundle,
    exec_compatible_with = constraints,
    tags = ["manual"],
    target_compatible_with = constraints,
    toolchain = "@elide_toolchain_%s//:cc_toolchain" % bundle,
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
) for bundle, constraints in {
    "darwin_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
}.items()]

alias(
    name = "llvm_nm",
    actual = select({
        "//tools:exec_linux_amd64": "@elide_toolchain_linux_amd64//:llvm_nm",
        "//tools:exec_linux_arm64": "@elide_toolchain_linux_arm64//:llvm_nm",
        "//tools:exec_macos_arm64": "@elide_toolchain_darwin_arm64//:llvm_nm",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "llvm_objdump",
    actual = select({
        "//tools:exec_linux_amd64": "@elide_toolchain_linux_amd64//:llvm_objdump",
        "//tools:exec_linux_arm64": "@elide_toolchain_linux_arm64//:llvm_objdump",
        "//tools:exec_macos_arm64": "@elide_toolchain_darwin_arm64//:llvm_objdump",
    }),
    visibility = ["//visibility:public"],
)

[alias(
    name = name,
    actual = select({
        "//tools:exec_linux_amd64": "@elide_toolchain_linux_amd64//:" + name,
        "//tools:exec_linux_arm64": "@elide_toolchain_linux_arm64//:" + name,
        "//tools:exec_macos_arm64": "@elide_toolchain_darwin_arm64//:" + name,
    }),
    visibility = ["//visibility:public"],
) for name in [
    "target_config",
    "all_files",
]]

constraint_setting(
    name = "linux_libc",
    default_constraint_value = ":glibc",
    visibility = ["//visibility:public"],
)

[constraint_value(
    name = libc,
    constraint_setting = ":linux_libc",
    visibility = ["//visibility:public"],
) for libc in [
    "glibc",
    "musl",
]]

config_setting(
    name = "linux_musl",
    constraint_values = [
        "@platforms//os:linux",
        ":musl",
    ],
    visibility = ["//visibility:public"],
)

[config_setting(
    name = "profile_" + profile,
    constraint_values = constraints,
    visibility = ["//visibility:public"],
) for profile, constraints in {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":glibc",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":glibc",
    ],
    "macos_arm64": [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
}.items()]


alias(
    name = "llvm_backend_tools",
    actual = select({
        "//tools:exec_linux_amd64": "@elide_toolchain_linux_amd64//:llvm_backend_tools",
        "//tools:exec_linux_arm64": "@elide_toolchain_linux_arm64//:llvm_backend_tools",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "llvm_link",
    actual = select({
        "//tools:exec_linux_amd64": "@elide_toolchain_linux_amd64//:bin/llvm-link",
        "//tools:exec_linux_arm64": "@elide_toolchain_linux_arm64//:bin/llvm-link",
        "//tools:exec_macos_arm64": "@elide_toolchain_darwin_arm64//:bin/llvm-link",
    }),
    visibility = ["//visibility:public"],
)
