load("@rules_java//java:java_test.bzl", "java_test")

exports_files([
    "benchmark_timer.patch",
    "sdk.patch",
    "sl.py.tpl",
    "sl_fixture_test.py",
    "shaded_inputs.json",
    "truffle.patch",
    "toolchain_test.py",
])

test_suite(
    name = "sdk_tests",
    tests = ["@graal//sdk:tests"],
)

java_test(
    name = "sdk_classpath_test",
    size = "small",
    srcs = ["SdkClasspathTest.java"],
    test_class = "graal.SdkClasspathTest",
    runtime_deps = [
        "@graal//sdk:GRAAL_SDK",
        "@graal//sdk:MAVEN_DOWNLOADER",
    ],
    deps = ["@contrib_rules_jvm_deps//:junit_junit"],
)

java_test(
    name = "truffle_processor_test",
    size = "small",
    srcs = ["TruffleProcessorTest.java"],
    test_class = "com.oracle.truffle.api.library.TruffleProcessorTest",
    deps = [
        "@contrib_rules_jvm_deps//:junit_junit",
        "@graal//truffle:com.oracle.truffle.api.library",
    ],
)

_LAUNCHER_MODULES = [
    "WORD",
    "COLLECTIONS",
    "NATIVEIMAGE",
    "POLYGLOT",
    "JLINE3",
    "LAUNCHER_COMMON",
]

java_test(
    name = "launcher_modules_test",
    size = "small",
    srcs = ["LauncherModulesTest.java"],
    data = ["@graal//sdk:" + name for name in _LAUNCHER_MODULES],
    env = {name: "$(rootpath @graal//sdk:" + name + ")" for name in _LAUNCHER_MODULES},
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    test_class = "graal.LauncherModulesTest",
    deps = ["@contrib_rules_jvm_deps//:junit_junit"],
)

java_test(
    name = "truffle_polyglot_test",
    size = "small",
    srcs = ["TrufflePolyglotTest.java"],
    test_class = "com.oracle.truffle.polyglot.isolate.TrufflePolyglotTest",
    runtime_deps = ["@graal//truffle:TRUFFLE_API_VERSION"],
    deps = [
        "@contrib_rules_jvm_deps//:junit_junit",
        "@graal//sdk:POLYGLOT",
        "@graal//truffle:com.oracle.truffle.polyglot",
    ],
)

java_test(
    name = "truffle_archive_test",
    size = "small",
    srcs = ["TruffleArchiveTest.java"],
    data = ["@graal//truffle:TRUFFLE_API"],
    env = {"TRUFFLE_API": "$(rootpath @graal//truffle:TRUFFLE_API)"},
    test_class = "graal.TruffleArchiveTest",
    deps = ["@contrib_rules_jvm_deps//:junit_junit"],
)

_RUNTIME_MODULES = ["@graal//sdk:" + name for name in [
    "WORD",
    "COLLECTIONS",
    "NATIVEIMAGE",
    "NATIVEBRIDGE",
    "JNIUTILS",
    "POLYGLOT",
]] + ["@graal//truffle:" + name for name in [
    "TRUFFLE_API",
    "TRUFFLE_COMPILER",
    "TRUFFLE_RUNTIME",
]]

java_test(
    name = "truffle_runtime_modules_test",
    size = "small",
    srcs = ["TruffleRuntimeModulesTest.java"],
    data = _RUNTIME_MODULES,
    env = {"MODULE_JARS": " ".join(["$(rootpath %s)" % jar for jar in _RUNTIME_MODULES])},
    test_class = "graal.TruffleRuntimeModulesTest",
    deps = ["@contrib_rules_jvm_deps//:junit_junit"],
)
