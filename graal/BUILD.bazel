[
    config_setting(
        name = "standalone_" + key,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for key, os, cpu in [
        ("darwin_aarch64", "macos", "aarch64"),
        ("linux_aarch64", "linux", "aarch64"),
        ("linux_amd64", "linux", "x86_64"),
    ]
]

