    size = "small",
    srcs = ["source_native_image_test.py"],
    args = ["$(rootpath :source_native_image_executable)"],
    data = [":source_native_image_executable"],
    main = "source_native_image_test.py",
    tags = ["manual"],
)

py_test(
    name = "source_native_image_test",
    size = "large",
    srcs = ["source_native_image_test.py"],
    args = [
        "$(rootpath @graal//substratevm:native-image)",
        "$(rootpath :source_native_image_guest)",
    ],
    data = [
        ":source_native_image_guest",
        "@graal//substratevm:native-image",
    ],
    tags = ["manual"],
)

py_binary(
    name = "pack_visualvm",
    srcs = ["pack_visualvm.py"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "visualvm_macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "visualvm_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

py_binary(
    name = "pack_sdk_llvm",
    srcs = ["pack_sdk_llvm.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "assemble_sdk_toolchain",
    srcs = ["assemble_sdk_toolchain.py"],
)

py_test(
    name = "sdk_toolchain_descriptors_test",
    size = "large",
    srcs = ["sdk_toolchain_descriptors_test.py"],
    args = [
        "$(rootpath @graal//sdk:LLVM_NINJA_TOOLCHAIN)",
        "$(rootpath @graal//sdk:MUSL_NINJA_TOOLCHAIN)",
        "$(rootpath @graal//sdk:MUSL_CMAKE_TOOLCHAIN)",
    ],
    data = [
        "@graal//sdk:LLVM_NINJA_TOOLCHAIN",
        "@graal//sdk:MUSL_CMAKE_TOOLCHAIN",
        "@graal//sdk:MUSL_NINJA_TOOLCHAIN",
    ],
    tags = ["manual"],
    target_compatible_with = select({
        "//tools:exec_linux_amd64": [],
        "//tools:exec_linux_arm64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

