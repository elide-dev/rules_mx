"""Select the Graal source archive that the checked-in overlays are applied to."""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Generated by tools/generate-graal from the source in //graal:source.json.
OVERLAYS = [
    Label("//graal:benchmark_timer.patch"),
    Label("//graal:espresso_static_libraries.patch"),
    Label("//graal:jfr_allocation_samples.patch"),
    Label("//graal:wasm_exports_test.patch"),
    Label("//graal:sdk.patch"),
    Label("//graal:compiler.patch"),
    Label("//graal:espresso-shared.patch"),
    Label("//graal:espresso.patch"),
    Label("//graal:espresso-compiler-stub.patch"),
    Label("//graal:web-image.patch"),
    Label("//graal:truffle.patch"),
    Label("//graal:substratevm.patch"),
    Label("//graal:vm.patch"),
    Label("//graal:regex.patch"),
    Label("//graal:tools.patch"),
    Label("//graal:sulong.patch"),
    Label("//graal:sandbox-toolchains.patch"),
    Label("//graal:wasm.patch"),
]

_source = tag_class(
    doc = "Replaces the default Graal source. Only the root module may declare it.",
    attrs = {
        "urls": attr.string_list(mandatory = True, doc = "Archive URLs of a Graal source tree."),
        "sha256": attr.string(doc = "SHA-256 of the archive. Prefer this or integrity."),
        "integrity": attr.string(doc = "Subresource Integrity digest of the archive."),
        "strip_prefix": attr.string(doc = "Directory prefix to remove from archive members."),
        "patches": attr.label_list(
            default = OVERLAYS,
            doc = "Overlay patches, applied with -p1. Defaults to the rules_mx overlays, which match //graal:source.json. Generate overlays for another revision with tools/generate-graal --output.",
        ),
    },
)

def _graal_impl(ctx):
    selected = None
    for module in ctx.modules:
        if not module.tags.source:
            continue
        if not module.is_root:
            fail("graal.source() may only be declared by the root module, not " + module.name)
        if len(module.tags.source) > 1:
            fail("Declare graal.source() at most once")
        selected = module.tags.source[0]
    if selected:
        source = struct(
            urls = selected.urls,
            sha256 = selected.sha256,
            integrity = selected.integrity,
            strip_prefix = selected.strip_prefix,
            patches = selected.patches,
        )
    else:
        pin = json.decode(ctx.read(Label("//graal:source.json")))
        source = struct(
            urls = pin["urls"],
            sha256 = pin["sha256"],
            integrity = "",
            strip_prefix = pin["strip_prefix"],
            patches = OVERLAYS,
        )
    http_archive(
        name = "graal",
        build_file_content = "",
        patch_strip = 1,
        patches = source.patches,
        sha256 = source.sha256,
        integrity = source.integrity,
        strip_prefix = source.strip_prefix,
        type = "tar.gz",
        urls = source.urls,
    )
    return ctx.extension_metadata(reproducible = bool(source.sha256 or source.integrity))

graal = module_extension(
    implementation = _graal_impl,
    tag_classes = {"source": _source},
    doc = "Provides @graal: a Graal source archive with BUILD overlays.",
)
