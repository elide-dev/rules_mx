load("@rules_mx//mx:graph.bzl", "mx_exported_tar", "mx_project", "mx_test_class", "mx_whole_java")

mx_whole_java(
    name = "check",
    testonly = True,
    srcs = ["//tests/gazelle/check/src/example/check:check.srcs"],
    javac_opts = [
        "--release",
        "17",
        "-parameters",
    ],
    unified_release = 17,
    visibility = ["//visibility:public"],
    deps = [
        ":client",
        ":demo",
        "@contrib_rules_jvm_deps//:junit_junit",
    ],
)

mx_test_class(
    name = "check.example.check.ConsumerTest",
    project = ":check",
    test_class = "example.check.ConsumerTest",
)

mx_project(
    name = "demo",
    packages = [
        "//tests/gazelle/src/main/java/example/api",
        "//tests/gazelle/src/main/java/example/app",
    ],
    visibility = ["//visibility:public"],
)

mx_project(
    name = "client",
    packages = ["//tests/gazelle/client/src/main/java/example/client"],
    visibility = ["//visibility:public"],
    deps = [":demo"],
)

mx_exported_tar(
    name = "BASE_LAYOUT",
    format = "tar",
    members = {
        "mx.demo/suite.py": "docs/suite.py",
    },
    visibility = ["//visibility:public"],
)

mx_exported_tar(
    name = "NESTED_LAYOUT",
    archive_imports = {
        ":BASE_LAYOUT": "docs/suite.py=share/suite.py",
    },
    format = "tar",
    members = {
        ":BASE_LAYOUT": "archives/base.tar",
    },
    visibility = ["//visibility:public"],
)
